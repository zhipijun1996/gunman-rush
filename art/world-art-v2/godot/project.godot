; Independent 640x360 material and native-lighting study.
config_version=5

[application]
config/name="失序之钟 · 16 区域素材与景深"
run/main_scene="res://study.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="16套原生像素区域素材、独立视差图层、原生灯光与地形遮挡的美术样例。"

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/min_width=640
window/size/min_height=360
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.08, 0.13, 0.18, 1)

[physics]
common/physics_ticks_per_second=60
