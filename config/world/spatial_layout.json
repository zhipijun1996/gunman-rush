    },
    "C16": {
      "a": "K-R06",
      "b": "G-R37",
      "a_section": "main",
      "requires": [
        []
      ],
      "reason": "外院供料路在古堡修钟前进入工城上街；HW/HD入口随C16迁移，首访与档案回访分开。"
    },
    "C18": {
      "a": "G-R35",
      "reason": "工城最高的保险试验间阳台接浮岛石桥，修复工城钟后放行；无需绕远的顶层走廊。"
    },
    "C23": {
      "a": "Z-R01",
      "reason": "墓园开启的回程门直接返回熟悉的钟心门厅，削去横穿塔基的长接廊。"
    },
    "C24": {
      "b": "K-R24",
      "reason": "古堡侧翼露台的维护口接钟心东侧基座，保持纹章与s24开启条件。"
    },
    "EXP-G_workers_yard_reward-03": {
      "b": "G-R12",
      "reason": "洗件池回铜匠院形成街区小环，橱窗、洗件池与工房庭院彼此相邻。"
    },
    "SC-G-EAST": {
      "b": "G-R18",
      "reason": "东支座打开向桥下行人廊的短楼梯，回到已见过的桥背；不再绕城连西台。"
    },
    "SC-G-BELL": {
      "b": "G-R23",
      "reason": "悬钟背架的检修出口落到工人会馆附近，完成高层后快速回整备点。"
    },
    "C21": {
      "a": "G-R11",
      "b": "N-R23",
      "a_section": "main",
      "b_section": "main",
      "reason": "恢复第二次矿井入城：从深矿检修井在内侧开启s21，抵达工坊试射室，与东站货梯承担不同回访。"
    },
    "room-link-124": {
      "a": "E-R15",
      "requires": [
        [
          "clock_E"
        ]
      ],
      "reason": "停炉后装卸站冷却格栅打开，露出攻击素材和返回工城的高位检修路。"
    },
    "room-link-173": {
      "a": "R-R15",
      "reason": "遗迹旧街沿真实市场连续前行，先经店街再到东侧上矿道；取消跨过店街的空廊。"
    },
    "room-link-174": {
      "a": "R-R03",
      "b": "R-R12",
      "requires": [
        [
          "clock_R"
        ]
      ],
      "reason": "排水后开启浅庭与旧城上环的近路，回到最初看见的水线；不保留横穿整个遗迹的空跑直线。"
    },
    "C26": {
      "b": "S-R13",
      "reason": "地穴出口先接西侧旧渡干堤，东侧干岸驿棚接平原；沿自然河岸在折桩浅湾汇合。"
    },
    "EXP-S_dry_bank-01": {
      "b": "S-R14",
      "reason": "平原驿棚抵达浅湾分岔，西去地穴干堤、下行沼泽外圈，不强制先往返西岸。"
    },
    "C29": {
      "a": "S-R10",
      "reason": "深区双闸廊沿排污口接下方遗迹东街，抗毒检查与高低水位关系一致。"
    },
    "room-link-185": {
      "b": "N-R03",
      "reason": "矿井中转台接实际同层的废井折台，平原入口与矿岔由主坑道相连。"
    },
    "C32": {
      "b": "N-R05",
      "b_section": "entry:L12",
      "reason": "遗迹东街的上矿坡进入深矿原有安全入口，沿同一HW/HD能力段进入主体，不从主街直接绕过能力锁。"
    },
    "C33": {
      "b": "N-R19",
      "reason": "排水后观潮厅开启矿泵维护口；分成泵廊、搬运段和检修竖井，再回交班台，避免一个房间拖出超长细管。"
    },
    "C34": {
      "a": "N-R14",
      "b": "E-R04",
      "reason": "炉后分流台的冷却回路接矿井交班绕坑道，修炉后才开放，不把炉前入口和深矿首次路线混在一起。"
    },
    "C35": {
      "b": "E-R11",
      "reason": "修炉后恢复冷却水道的运维小舟，遗迹观潮岸与炉下横庭是具名停靠点，不伪装成长步行细线。"
    },
    "C22": {
      "b": "E-R15",
      "reason": "独立装卸到达厅承接工城货运，HDQ检验后进入炉口；卸料与炉内战斗分开。"
    },
    "room-link-187": {
      "a": "N-R04",
      "b": "N-R13",
      "reason": "把入口旁的重复三角改成废井、矿岔与搬运层的实际短环，平原入口不跨过相邻房直接接远层。"
    },
    "C11": {
      "a": "Y-R13",
      "reason": "悬台长段拆出观墓前崖，给墓园入口独立的远望和接近空间，收集仍留Y06。"
    },
    "room-link-154": {
      "b": "Z-R17",
      "reason": "封印外接近段先落在检修台，再经分层观测井到星桥，取消一房承担整条巨型折廊。"
    },
    "C25": {
      "a": "Z-R18",
      "reason": "星桥从同高度接引露台进入；原修钟条件保持，入口仍在钟心最终封印之前。"
    },
    "room-link-088": {
      "requires": [
        [
          "royal_sigil",
          "clock_K"
        ]
      ],
      "reason": "外院供料廊开放后，档案入口仍保护内廷修钟回访，不能从物流门绕过。"
    },
    "room-link-089": {
      "b_section": "entry:L30",
      "requires": [
        [
          "clock_K"
        ]
      ],
      "reason": "供料廊侧也先进入收藏前台，保留HWDQ挑战，不让新增外院路绕过K15收藏资格。"
    }
  },
