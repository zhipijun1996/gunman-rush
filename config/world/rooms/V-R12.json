    "V12:entry_sign": {
      "component": "array:signs",
      "id": "V12:entry_sign",
      "order": 0,
      "properties": {
        "point": [
          192,
          1814
        ],
        "route_guide": {
          "legend": [
            {
              "instruction": "Q可用时用反冲穿越，结束反冲前必须离开光幕；普通跳跃、钩索不提供穿幕保护。",
              "label": "金色：反冲保护光幕",
              "mode": "phase_light"
            },
            {
              "instruction": "接触危险，Q也无法抵挡；绕行，失误返回最近恢复点。",
              "label": "粉红：实体尖刺",
              "mode": "thorns"
            }
          ],
          "schema": 1,
          "steps": [
            {
              "action": "向右上反冲，二段跳接第一面墙；向墙移动即可攀附并恢复次数。",
              "label": "起步接墙",
              "number": 1,
              "path": [
                [
                  144,
                  1838
                ],
                [
                  260,
                  1740
                ],
                [
                  338,
                  1680
                ]
              ],
              "point": [
                240,
                1760
              ]
            },
            {
              "action": "沿第一面墙下滑，到墙脚下方横向反冲，二段跳抬起后向上抓低位钩点。别落入粉红刺床。左上墙是可选练习支路。",
              "label": "绕墙脚抓环",
              "number": 2,
              "path": [
                [
                  338,
                  1700
                ],
                [
                  338,
                  1800
                ],
                [
                  424,
                  1800
                ],
                [
                  528,
                  1660
                ]
              ],
              "point": [
                428,
                1788
              ]
            },
            {
              "action": "挂环等Q冷却结束，向下射击，反冲向上一次穿出金色光幕；二段跳向右接内墙。",
              "label": "反冲穿光幕",
              "number": 3,
              "path": [
                [
                  544,
                  1648
                ],
                [
                  544,
                  1488
                ],
                [
                  594,
                  1412
                ]
              ],
              "point": [
                552,
                1600
              ]
            },
            {
              "action": "贴墙恢复后，用墙跳、向上反冲和二段跳越过墙顶，落到中继台。失误从这里重试。",
              "label": "中继落地",
              "number": 4,
              "path": [
                [
                  594,
                  1412
                ],
                [
                  568,
                  1190
                ],
                [
                  720,
                  1198
                ]
              ],
              "point": [
                702,
                1174
              ]
            },
            {
              "action": "从中继台向右上反冲，二段跳接右侧外墙，再次恢复次数。",
              "label": "斜跨外墙",
              "number": 5,
              "path": [
                [
                  740,
                  1198
                ],
                [
                  868,
                  1080
                ],
                [
                  898,
                  1000
                ]
              ],
              "point": [
                856,
                1100
              ]
            },
            {
              "action": "从外墙向左上推进，先绕开隔墙下缘，再向上抓高位钩点。",
              "label": "绕隔墙抓高环",
              "number": 6,
              "path": [
                [
                  898,
                  1000
                ],
                [
                  828,
                  866
                ],
                [
                  664,
                  866
                ],
                [
                  624,
                  720
                ]
              ],
              "point": [
                660,
                850
              ]
            },
            {
              "action": "挂环等Q就绪，向右上射击使反冲朝左下；穿过金幕后接内侧墙。普通下落不受保护。",
              "label": "向左下穿幕",
              "number": 7,
              "path": [
                [
                  624,
                  704
                ],
                [
                  560,
                  742
                ],
                [
                  480,
                  782
                ],
                [
                  414,
                  836
                ]
              ],
              "point": [
                560,
                742
              ]
            },
            {
              "action": "从内侧墙向右上反冲，二段跳接高墙左面；绕开上方齿轮和墙顶刺。",
              "label": "接高墙",
              "number": 8,
              "path": [
                [
                  414,
                  836
                ],
                [
                  560,
                  690
                ],
                [
                  658,
                  576
                ]
              ],
              "point": [
                572,
                632
              ]
            },
            {
              "action": "墙跳、反冲和二段跳越过高墙，落到终台；拉手柄放桥，沿左侧落井回入口。",
              "label": "终台与返程",
              "number": 9,
              "path": [
                [
                  658,
                  576
                ],
                [
                  612,
                  364
                ],
                [
                  744,
                  284
                ],
                [
                  880,
                  302
                ]
              ],
              "point": [
                850,
                260
              ]
            }
          ]
        },
        "text": "所有实体墙面均可攀附，墙刺危险。攀墙或钩头命中恢复空弹、D/H和Q资格，冷却保留。按编号向前；1接墙，2绕墙脚抓环，3向上反冲穿金色光幕。"
      }
    },
