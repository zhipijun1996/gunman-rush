    "V12:entry_sign": {
      "definition_id": "interaction.sign",
      "definition_version": 1,
      "id": "V12:entry_sign",
      "order": 0,
      "properties": {
        "point": [
          192.0,
          1814.0
        ],
        "route_guide": {
          "legend": [
            {
              "instruction": "Q可用时用反冲穿越，结束反冲前必须离开光幕；普通跳跃、钩索不提供穿幕保护。",
              "label": "金色：反冲保护光幕",
              "mode": "phase_light"
            },
            {
              "instruction": "接触危险，Q也无法抵挡；绕行，失误返回最近恢复点。",
              "label": "粉红：实体尖刺",
              "mode": "thorns"
            }
          ],
          "schema": 1.0,
          "steps": [
            {
              "action": "向右上反冲，二段跳接第一面墙；向墙移动即可攀附并恢复次数。",
              "label": "起步接墙",
              "number": 1.0,
              "path": [
                [
                  144.0,
                  1838.0
                ],
                [
                  260.0,
                  1740.0
                ],
                [
                  338.0,
                  1680.0
                ]
              ],
              "point": [
                240.0,
                1760.0
              ]
            },
            {
              "action": "沿第一面墙下滑，到墙脚下方横向反冲，二段跳抬起后向上抓低位钩点。别落入粉红刺床。左上墙是可选练习支路。",
              "label": "绕墙脚抓环",
              "number": 2.0,
              "path": [
                [
                  338.0,
                  1700.0
                ],
                [
                  338.0,
                  1800.0
                ],
                [
                  424.0,
                  1800.0
                ],
                [
                  528.0,
                  1660.0
                ]
              ],
              "point": [
                428.0,
                1788.0
              ]
            },
            {
              "action": "挂环等Q冷却结束，向下射击，反冲向上一次穿出金色光幕；二段跳向右接内墙。",
              "label": "反冲穿光幕",
              "number": 3.0,
              "path": [
                [
                  544.0,
                  1648.0
                ],
                [
                  544.0,
                  1488.0
                ],
                [
                  594.0,
                  1412.0
                ]
              ],
              "point": [
                552.0,
                1600.0
              ]
            },
            {
              "action": "贴墙恢复后，用墙跳、向上反冲和二段跳越过墙顶，落到中继台。失误从这里重试。",
              "label": "中继落地",
              "number": 4.0,
              "path": [
                [
                  594.0,
                  1412.0
                ],
                [
                  568.0,
                  1190.0
                ],
                [
                  720.0,
                  1198.0
                ]
              ],
              "point": [
                702.0,
                1174.0
              ]
            },
            {
              "action": "从中继台向右上反冲，二段跳接右侧外墙，再次恢复次数。",
              "label": "斜跨外墙",
              "number": 5.0,
              "path": [
                [
                  740.0,
                  1198.0
                ],
                [
                  868.0,
                  1080.0
                ],
                [
                  898.0,
                  1000.0
                ]
              ],
              "point": [
                856.0,
                1100.0
              ]
            },
            {
              "action": "从外墙向左上推进，先绕开隔墙下缘，再向上抓高位钩点。",
              "label": "绕隔墙抓高环",
              "number": 6.0,
              "path": [
                [
                  898.0,
                  1000.0
                ],
                [
                  828.0,
                  866.0
                ],
                [
                  664.0,
                  866.0
                ],
                [
                  624.0,
                  720.0
                ]
              ],
              "point": [
                660.0,
                850.0
              ]
            },
            {
              "action": "挂环等Q就绪，向右上射击使反冲朝左下；穿过金幕后接内侧墙。普通下落不受保护。",
              "label": "向左下穿幕",
              "number": 7.0,
              "path": [
                [
                  624.0,
                  704.0
                ],
                [
                  560.0,
                  742.0
                ],
                [
                  480.0,
                  782.0
                ],
                [
                  414.0,
                  836.0
                ]
              ],
              "point": [
                560.0,
                742.0
              ]
            },
            {
              "action": "从内侧墙向右上反冲，二段跳接高墙左面；绕开上方齿轮和墙顶刺。",
              "label": "接高墙",
              "number": 8.0,
              "path": [
                [
                  414.0,
                  836.0
                ],
                [
                  560.0,
                  690.0
                ],
                [
                  658.0,
                  576.0
                ]
              ],
              "point": [
                572.0,
                632.0
              ]
            },
            {
              "action": "墙跳、反冲和二段跳越过高墙，落到终台；拉手柄放桥，沿左侧落井回入口。",
              "label": "终台与返程",
              "number": 9.0,
              "path": [
                [
                  658.0,
                  576.0
                ],
                [
                  612.0,
                  364.0
                ],
                [
                  744.0,
                  284.0
                ],
                [
                  880.0,
                  302.0
                ]
              ],
              "point": [
                850.0,
                260.0
              ]
            }
          ]
        },
        "text": "所有实体墙面均可攀附，墙刺危险。攀墙或钩头命中恢复空弹、D/H和Q资格，冷却保留。按编号向前；1接墙，2绕墙脚抓环，3向上反冲穿金色光幕。"
      }
    },
