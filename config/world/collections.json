  "authority_rule": "最新用户确认优先；当前world canonical定义所有空间与交互；本文件明确区分confirmed/current_budget/trial_default/proposal。",
  "confirmed_rules": [
    {
      "id": "COL-C01",
      "rule": "8份攻击材料；升级消耗1/2/2/3；永久提高武器攻击力。"
    },
    {
      "id": "COL-C02",
      "rule": "6件分支材料与2枚共用技能材料独立于攻击合金；每武器可有2技能。"
    },
    {
      "id": "COL-C03",
      "rule": "约50装备，NPC购买、任务与地图取得；6次负荷扩容，每次+1；约40齿轮交给NPC兑奖。"
    },
    {
      "id": "COL-C04",
      "rule": "收集、成长与奖励永久保存且唯一；重复装备升级改向NPC支付金币。"
    },
    {
      "id": "COL-C05",
      "rule": "灯与抗毒道具可装卸；拥有与当前装配分开。"
    },
    {
      "id": "COL-C06",
      "rule": "本局/每图/锁装以明确休息为周期边界；休息恢复HP并重置普通敌人。"
    },
    {
      "id": "COL-C07",
      "rule": "死亡回休息点；地形失败回本次挑战入口；普通扣1HP、标记特别危险扣2HP。"
    },
    {
      "id": "COL-C08",
      "rule": "完整攻击就是一枪；三连/激光完整单目标命中1.5B；普通安全窗口2枪、3枪贪刀；最低普通敌人9HP。"
    }
  ],
