{
  "schema_version": 1,
  "description": "Finite reviewed routing rules, not inferred GDScript reachability. Unknown production paths fail closed to full. Existing Harness checks and budgets remain authoritative.",
  "domains": {
    "process": {"development": [], "integration": [], "depends_on": []},
    "planner": {"development": ["harness-tests"], "integration": ["harness-tests"], "depends_on": []},
    "movie": {"development": ["capture-tests"], "integration": ["capture-tests", "actor-actions", "action-budget"], "depends_on": []},
    "player_presentation": {"development": ["environment", "underworld-player-animation", "actor-actions"], "integration": [], "depends_on": [], "full_integration": true},
    "damage_presentation": {"development": ["environment", "underworld-damage-feedback"], "integration": [], "depends_on": [], "full_integration": true},
    "ui_presentation": {"development": ["environment", "underworld-ui"], "integration": [], "depends_on": [], "full_integration": true},
    "web": {"development": ["web-cache", "web-resource-contract-tests", "runtime-raw-export-tests"], "integration": ["web-build", "web-bundle"], "depends_on": ["web_contracts"]},
    "web_contracts": {"development": ["web-cache", "web-resource-contract-tests", "runtime-raw-export-tests"], "integration": ["web-cache", "web-resource-contract-tests", "runtime-raw-export-tests"], "depends_on": []}
  },
  "rules": [
    {"id": "planner", "paths": ["tools/production_plan.py", "config/production_impact.json", "tests/test_production_plan.py"], "domain": "planner", "reason": "Impact planner requires its fail-closed regression suite in addition to Harness regression."},
    {"id": "docs", "paths": ["docs/*", ".agents/skills/*", "AGENTS.md", "README.md", ".github/pull_request_template.md"], "domain": "process", "reason": "Documentation and task records use the complete existing docs profile."},
    {"id": "movie", "paths": ["tools/capture_actions.py", "tools/action_movie_capture.gd", "tools/action_movie_capture.gd.uid", "tests/test_capture_actions.py"], "domain": "movie", "reason": "Existing accepted-input recording producer and its strict reader."},
    {"id": "player-presentation", "paths": ["scripts/art/avatar_presentation.gd", "scripts/art/avatar_presentation.gd.uid", "scripts/art/player_visual_adapter.gd", "scripts/art/player_visual_adapter.gd.uid"], "domain": "player_presentation", "reason": "Shared player presentation has real animation consumers; integration cannot prove interface compatibility from paths alone."},
    {"id": "damage-presentation", "paths": ["scripts/art/player_feedback.gd", "scripts/art/player_feedback.gd.uid", "scripts/art/defeat_burst.gd", "scripts/art/defeat_burst.gd.uid", "scripts/enemies/enemy_presentation.gd", "scripts/enemies/enemy_presentation.gd.uid"], "domain": "damage_presentation", "reason": "Shared accepted hit/death presentation needs full integration after targeted development feedback."},
    {"id": "ui-presentation", "paths": ["scripts/ui/underworld_ui.gd", "scripts/ui/underworld_ui.gd.uid", "scripts/ui/focus_vignette.gd", "scripts/ui/focus_vignette.gd.uid"], "domain": "ui_presentation", "reason": "Known UI presentation consumers; shared interaction/interface changes retain conservative integration."},
    {"id": "web-contracts", "paths": ["tools/web/*", "tools/verify_web_*.py", "tools/check_web_*.py", "tools/test_web_*.mjs", "tests/test_web_bundle.py", "tests/test_runtime_raw_export.py"], "domain": "web", "reason": "Web loader and export contracts require real export and bundle verification at integration."}
  ],
  "always_full": ["project.godot", "export_presets.cfg", "config/*", "resources/*", "scenes/*", "scripts/player/*", "scripts/core/*", "scripts/generation/*", "scripts/save/*", ".github/workflows/*", "tools/harness.py", "tools/harness/*"],
  "manual_checks": ["GUI and real device/player acceptance remain unverified unless separately exercised.", "A changed shared API, dynamic loader or undeclared dependency requires full integration even if its file has a development mapping.", "Check inputs are cache invalidation inventories, not complete test dependency graphs."]
}
