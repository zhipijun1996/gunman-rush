{
  "schema_version": 1,
  "checks": {
    "docs": {
      "argv": [
        "python3",
        "tools/check_docs.py"
      ],
      "timeout_seconds": 60,
      "success_pattern": "^PASS:"
    },
    "world": {
      "argv": [
        "python3",
        "tools/check_world_design.py"
      ],
      "timeout_seconds": 60,
      "success_pattern": "^PASS:"
    },
    "structure": {
      "argv": [
        "python3",
        "tools/check_project.py"
      ],
      "timeout_seconds": 60,
      "success_pattern": "^PASS: project structure"
    },
    "harness-tests": {
      "argv": [
        "python3",
        "tests/test_harness.py"
      ],
      "timeout_seconds": 60,
      "success_pattern": "^OK$"
    },
    "environment": {
      "argv": [
        "bash",
        "tools/cloud_start.sh",
        "--godot-only"
      ],
      "timeout_seconds": 60,
      "success_pattern": "\"missing_or_failed\": \\[\\]"
    },
    "core": {
      "argv": [
        "python3",
        "tools/run_tests.py"
      ],
      "timeout_seconds": 720,
      "success_pattern": "^ALL TESTS: [1-9]\\d* assertions, 0 failures$"
    },
    "legacy": {
      "argv": [
        "python3",
        "tools/run_plains_ten_tests.py"
      ],
      "timeout_seconds": 2100,
      "success_pattern": "^PLAINS EIGHT SUITES: [1-9]\\d* suites passed$"
    },
    "region": {
      "argv": [
        "python3",
        "tools/run_plains_region_tests.py"
      ],
      "timeout_seconds": 1500,
      "success_pattern": "^PLAINS REGION SUITES: 15 suites passed$"
    },
    "art-art": {
      "argv": [
