extends "res://tests/world/plains_region_routes.gd"
## Declared return approaches. H is used only in the post-victory clock shaft.
func begin(rid: String,at: Vector2,stage: String="base") -> void:
 await app.review.begin(rid,"",stage)
 app.player.reset_at(at);await ticks(5)
func run() -> void:
 app=preload("res://game/application/world/fixed_world.tscn").instantiate();app.save_path="user://plains_region_galleries.json"
 root.add_child(app)
 await begin("P-R02",Vector2(448,1518))
 await rise_then_cross(Vector2(256,1390),true)
 check(await walk(Vector2(368,1390),"P-R02"),"shelter lower roof")
 await hop(Vector2(544,1262),Vector2(-.4,1))
 check(await walk(Vector2(464,1262),"P-R02"),"shelter middle roof")
 await hop(Vector2(224,1166),Vector2(.7,1))
 check(await route([Vector2(160,1166),Vector2(160,1006)],"P-R02","P-R30"),"roof route enters the actual water-cave pair")
 if failures>0:await finish_galleries();return
 await begin("P-R15",Vector2(1056,3182),"h")
 var candidate:=app.state.value.duplicate(true);candidate.flags.append("boss_P_WINDKEEPER_defeated")
 app.state.commit(candidate,app.state.revision);app._apply_capabilities()
 await rise_then_cross(Vector2(944,3038),true)
 for at: Vector2 in [Vector2(1120,2894),Vector2(944,2750),Vector2(1120,2606),Vector2(944,2462),Vector2(1120,2318)]:
  await hop(at,Vector2(-.4 if at.x>app.player.position.x else .4,1))
 check(await walk(Vector2(1200,2318),"P-R15"),"clear the balcony underside before climbing")
 await rise_then_cross(Vector2(1008,2158),true)
 check(absf(app.player.position.y-2158)<8,"clock chamber returns to the shaft balcony")
 app.controller.router.set_jump_held(&"keyboard_mouse",true);await ticks(8)
 for i: int in range(3,app.room.hook_points.size()):
  check(await hook(app.room.hook_points[i]),"clock reverse shaft ring "+str(i))
  if failures>0:await finish_galleries();return
  app.controller.router.set_jump_held(&"keyboard_mouse",false)
 app.controller.router.set_source_axis(&"keyboard_mouse",0)
 app.controller.router.set_jump_held(&"keyboard_mouse",true);await ticks(8)
 app.controller.router.set_jump_held(&"keyboard_mouse",false)
 check(await route([Vector2(672,142),Vector2(672,-18)],"P-R15","P-R14"),"earned-H route returns through the actual clock upper door")
 await begin("P-R17",Vector2(640,782))
 check(await path([Vector2(592,622),Vector2(368,622),Vector2(304,478),Vector2(368,334),Vector2(304,190),Vector2(448,142)],"P-R17"),"hidden mill preview has a real return without H")
 await begin("P-R19",Vector2(1120,1134))
 check(await path([Vector2(1008,990),Vector2(1120,846),Vector2(1072,846),Vector2(1008,702),Vector2(1120,558),Vector2(1072,558),Vector2(1008,414),Vector2(1120,270),Vector2(1064,270)],"P-R19"),"root well return stays independent of H+D reward")
 await rise_then_cross(Vector2(1152,142))
 check(absf(app.player.position.y-142)<8,"root well upper return landing")
 await begin("P-R28",Vector2(1280,526))
 check(await path([Vector2(1088,462),Vector2(976,462)],"P-R28"),"old field return ridge")
 await hop(Vector2(912,302),Vector2(.25,1));await hop(Vector2(1104,142),Vector2(-.4,1))
 check(absf(app.player.position.y-142)<8,"old field recoil return")
 await begin("P-R31",Vector2(256,654))
 await rise_then_cross(Vector2(160,526),true)
 await walk(Vector2(176,526),"P-R31")
 await hop(Vector2(416,398),Vector2(-.7,1));await walk(Vector2(336,398),"P-R31")
 await hop(Vector2(192,270),Vector2(.5,1));await walk(Vector2(208,270),"P-R31")
 await hop(Vector2(480,142),Vector2(-.9,1))
 check(await route([Vector2(480,-18)],"P-R31","P-R08"),"bell field returns to the physical well mouth")
 await begin("P-R32",Vector2(640,1134))
 check(await path([Vector2(480,990)],"P-R32"),"long bridge low route reaches west pier")
 await rise_then_cross(Vector2(672,846))
 check(await path([Vector2(704,750),Vector2(256,750)],"P-R32"),"long bridge raised bank")
 await begin("P-R33",Vector2(1248,878))
 await hop(Vector2(1040,766),Vector2(.6,1))
 for pair: Array in [[Vector2(976,766),Vector2(864,654)],[Vector2(752,654),Vector2(640,526)],[Vector2(528,526),Vector2(416,398)],[Vector2(304,398),Vector2(192,270)]]:
  await walk(pair[0],"P-R33");await rise_then_cross(pair[1],true)
 check(await route([Vector2(6,270)],"P-R33","P-R32"),"quiet clock terraces return to the actual bridge door")
 await finish_galleries()
func finish_galleries() -> void:
 await WorldAudioLifecycle.drain_world(app);app.queue_free();await ticks(8)
 print("PLAINS REGION GALLERIES: ",failures," failures");quit(failures)
