extends "res://tests/world/plains_region_routes.gd"
## Qualified lower-return fixtures followed exclusively by accepted movement input.
func begin(rid: String,at: Vector2) -> void:
 app.controller.router.clear("gallery_fixture");app.load_room(rid,"");await settle();app.player.reset_at(at);await ticks(5)
func run() -> void:
 app=preload("res://game/application/world/fixed_world.tscn").instantiate();app.save_path="user://plains_region_galleries.json"
 for suffix: String in ["",".backup",".tmp",".corrupt"]:DirAccess.remove_absolute(app.save_path+suffix)
 root.add_child(app);app.start_new();await settle()
 var candidate:=app.state.value.duplicate(true)
 candidate.flags.append_array(["intro_move","intro_shoot","intro_complete","station_briefed"])
 app.state.commit(candidate,app.state.revision);app._apply_capabilities()
 await begin("P-R02",Vector2(448,494))
 check(await path([Vector2(400,366),Vector2(560,238),Vector2(664,238)],"P-R02"),"rest shelter broad west roof route")
 await rise_then_cross(Vector2(592,142))
 check(absf(app.player.position.y-142)<8,"shelter west roof landing")
 await begin("P-R15",Vector2(1040,1182))
 await rise_then_cross(Vector2(960,990),true)
 check(await path([Vector2(1008,990),Vector2(1120,846),Vector2(1072,846),Vector2(1008,702),Vector2(1120,558),Vector2(1072,558),Vector2(1008,414),Vector2(1120,270),Vector2(1064,270)],"P-R15"),"clock west galleries return without H")
 await rise_then_cross(Vector2(1152,142))
 check(absf(app.player.position.y-142)<8,"clock upper return landing")
 await begin("P-R17",Vector2(640,782))
 check(await path([Vector2(592,622),Vector2(368,622),Vector2(304,478),Vector2(368,334),Vector2(304,190),Vector2(448,142)],"P-R17"),"hidden mill preview has a real return without H")
 await begin("P-R19",Vector2(1120,1134))
 check(await path([Vector2(1008,990),Vector2(1120,846),Vector2(1072,846),Vector2(1008,702),Vector2(1120,558),Vector2(1072,558),Vector2(1008,414),Vector2(1120,270),Vector2(1064,270)],"P-R19"),"root well west galleries return independently of H+D reward")
 await rise_then_cross(Vector2(1152,142))
 check(absf(app.player.position.y-142)<8,"root well upper return landing")
 await begin("P-R28",Vector2(1280,526))
 check(await path([Vector2(1088,462),Vector2(976,462)],"P-R28"),"old field raised ridge reaches return pier")
 await hop(Vector2(912,302),Vector2(.25,1))
 await hop(Vector2(1104,142),Vector2(-.4,1))
 check(absf(app.player.position.y-142)<8,"old field recoil reaches upper return")
 await begin("P-R31",Vector2(1120,878))
 check(await path([Vector2(1040,734),Vector2(1120,590),Vector2(1104,590),Vector2(1040,446),Vector2(1120,302)],"P-R31"),"bell field broad navigation galleries")
 await walk(Vector2(1328,302),"P-R31")
 await rise_then_cross(Vector2(1152,142),true)
 check(app.player.is_on_floor() and absf(app.player.position.y-142)<8,"bell field reaches actual upper landing")
 await begin("P-R32",Vector2(640,1134))
 check(await path([Vector2(480,990)],"P-R32"),"long bridge low route can return to raised west exit")
 await rise_then_cross(Vector2(672,846))
 check(await path([Vector2(704,750),Vector2(256,750)],"P-R32"),"long bridge connects raised west bank")
 await begin("P-R33",Vector2(736,878))
 check(await path([Vector2(656,766),Vector2(592,654)],"P-R33"),"quiet clock forecourt returns by two broad galleries")
 await WorldAudioLifecycle.drain_world(app);app.queue_free();await ticks(8)
 print("PLAINS REGION GALLERIES: ",failures," failures");quit(failures)
