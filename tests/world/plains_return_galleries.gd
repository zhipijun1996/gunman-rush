extends "res://tests/world/plains_first_loop.gd"
## Removing dense rungs must preserve actual upper returns, not just entry spawns.
func run() -> void:
 app=preload("res://game/application/world/fixed_world.tscn").instantiate();app.save_path="user://plains_galleries.json"
 for suffix: String in ["",".backup",".tmp",".corrupt"]:DirAccess.remove_absolute(app.save_path+suffix)
 root.add_child(app);await app.review.begin("P-R03","","base")
 check(await path([Vector2(496,1182),Vector2(880,1134)],"P-R03"),"revisit the original meadow slope")
 await rise_then_cross(Vector2(752,1006),true)
 check(await walk(Vector2(752,1006),"P-R03"),"prepare on the broad lower ledge")
 await hop(Vector2(944,878),Vector2(-.4,1))
 check(await walk(Vector2(992,878),"P-R03"),"regain the east launch edge")
 await hop(Vector2(1184,766),Vector2(-.6,1))
 check(await walk(Vector2(1184,766),"P-R03"),"stand clear of the upper ledge underside")
 await rise_then_cross(Vector2(1056,622),true)
 check(await walk(Vector2(1120,622),"P-R03"),"west shoulder approach")
 await hop(Vector2(1344,478),Vector2(-.6,1))
 check(await walk(Vector2(1248,478),"P-R03"),"east shoulder approach")
 await hop(Vector2(1056,334),Vector2(.6,1))
 check(await walk(Vector2(1120,334),"P-R03"),"upper return launch")
 await hop(Vector2(1280,142),Vector2(-.4,1))
 check(await path([Vector2(1280,142),Vector2(1280,-18)],"P-R03"),"meadow broad return reaches its actual upper door")
 await settle();check(app.room.room_id=="P-R13","meadow reconnects to the old shoulder")
 app.load_room("P-R22","");await settle()
 check(await path([Vector2(320,718),Vector2(160,590),Vector2(320,462),Vector2(160,334)],"P-R22"),"canal staggered galleries replace small ladder rungs")
 await hop(Vector2(352,142),Vector2(-.4,1))
 check(app.player.is_on_floor() and absf(app.player.position.y-142)<8,"recoil reaches upper return shelf")
 await WorldAudioLifecycle.drain_world(app);app.queue_free();await ticks(8)
 print("PLAINS RETURN GALLERIES: ",failures," failures");quit(failures)
