extends "res://tests/world/plains_first_loop.gd"
## Enter from the real well door, explore HP01, then fold through the field.
func run() -> void:
	app=preload("res://game/application/world/fixed_world.tscn").instantiate()
	app.save_path="user://plains_west_pressure.json"
	for suffix: String in ["",".backup",".tmp",".corrupt"]:DirAccess.remove_absolute(app.save_path+suffix)
	root.add_child(app);app.start_new();await settle()
	app.load_room("P-R06","room-link-139:P-R06");await settle()
	check(app.player.is_on_floor(),"well entry lands on actual side bank")
	await clear_enemies(112)
	await hop(Vector2(640,878),Vector2(1,.2))
	check(await walk(Vector2(600,878),"P-R06"),"approach low barricade")
	await full_jump(Vector2(368,878))
	check(await route([Vector2(6,878)],"P-R06","P-R13"),"junction main path")
	check(await path([Vector2(1120,750),Vector2(944,798)],"P-R13"),"read shoulder reward and lower return")
	await clear_enemies(112)
	await hop(Vector2(672,750),Vector2(1,.2))
	check(await walk(Vector2(560,638),"P-R13"),"find lower departure behind the shoulder")
	check(await walk(Vector2(624,638),"P-R13"),"read low ceiling and collectible landing")
	await hop(Vector2(1024,526),Vector2(-1,.25))
	check(absf(app.player.position.y-526)<8,"recoil below overhang to reward shelf")
	check(await walk(Vector2(1024,526),"P-R13"),"approach HP01 physically")
	app.controller.router.request_action(&"interact");await ticks(6)
	check(app.state.value.receipts.has("pickup_HP01"),"earned HP01 from approach")
	check(await walk(Vector2(1120,526),"P-R13"),"reward-side ladder release")
	app.controller.router.request_action(&"interact");await ticks(6)
	check(app.state.has("reward_return_HP01_open"),"open committed local return")
	check(await path([Vector2(1216,622),Vector2(1200,718),Vector2(1280,750),Vector2(1120,750),Vector2(944,798)],"P-R13"),"return to the main road without reversing challenge")
	await clear_enemies(112)
	await hop(Vector2(672,750),Vector2(1,.2))
	check(await route([Vector2(6,750)],"P-R13","P-R04"),"shoulder continues into field")
	check(await field_route(),"folded field: lower encounters, recoil shoulder, upper barricade and thorns")
	await settle();check(app.room.room_id=="P-R25","field connects to orchard through upper door")
	check(app.controller.actor_resources.health.current>0,"connected route alive")
	await WorldAudioLifecycle.drain_world(app);app.queue_free();await ticks(8)
	print("PLAINS WEST PRESSURE: ",failures," failures");quit(failures)
