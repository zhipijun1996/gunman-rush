extends "res://tests/world/station_arrival.gd"
func run()->void:
 root.size=Vector2i(1280,720)
 app=preload("res://game/application/world/fixed_world.tscn").instantiate()
 app.save_path="user://clockheart_formal.json";root.add_child(app)
 for suffix:String in ["",".backup",".tmp",".corrupt"]:DirAccess.remove_absolute(app.save_path+suffix)
 app.start_new();await settle()
 app.load_room("P-R01","");await settle()
 app.player.reset_at(Vector2(640,1262));await ticks(8)
 check(app.story.active,"formal station welcome starts")
 app.story.finish();await ticks(100)
 check(app.story.figure.visible and app.story.figure.position.x>1952,"guard moves to actual north exit after skipped welcome")
 app.player.reset_at(Vector2(1980,366));await ticks(8)
 check(app.story.active and app.story.guarding,"approaching north starts guard response")
 app.story.finish();await ticks(120)
 check(not app.paused and app.controller.active and app.player.position.x<1952,"skip guard retreats safely without opening route")
 app.load_room("P-R33","");await settle()
 app.player.reset_at(Vector2(1536,558));await ticks(4);app._interact();await ticks(100)
 check(app.room.room_id=="Z-R01" and app.controller.active,"formal forecourt enters authorized clockheart")
 app.player.reset_at(Vector2(640,622));await ticks(5)
 check(app.story.active,"ruined heart explanation starts inside")
 app.story.finish();await ticks(8)
 check(app.state.has("clockheart_briefed"),"skip investigation commits same permission")
 app.player.reset_at(Vector2(256,622));await ticks(4);app._interact();await ticks(100)
 check(app.room.room_id=="P-R33" and app.controller.active,"interior front door returns to forecourt")
 app.load_room("P-R01","");await settle()
 for door:Dictionary in app.room.doors:
  if door.target_room=="P-R08":check(app.room.door_open.get(door.id,false),"return unlocks north")
 check(not app.story.figure.visible,"no guard remains after actual investigation")
 var restored:=FixedWorldState.new();restored.content=app.content;restored.storage=app.state.storage
 check(restored.restore() and restored.has("clockheart_briefed"),"normal save reload preserves investigation")
 await WorldAudioLifecycle.drain_world(app);quit(failures)
