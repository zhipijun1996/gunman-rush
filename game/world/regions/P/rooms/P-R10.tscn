arrival_text = "高风车连台"
route_guide = {
"schema": 1.0,
"steps": [{
"action": "从宽岸轻跳到空怪上方，向下命中恢复一发，再向下射登上352高的宽接落岸；不要求瞄准换向。",
"label": "第一课：两次向下射",
"number": 1.0,
"path": [[896.0, 2030.0], [974.0, 1887.0], [1004.0, 1734.0], [1056.0, 1678.0]],
"point": [896.0, 2030.0]
}, {
"action": "准备后起跳朝右下击中空怪并补弹，再改为向下射，身体回收至左侧352高宽岸；只多学一次瞄准换向，464宽准备岸右端退到1360为H脱钩保留净空。",
"label": "第二课：斜下转向下",
"number": 2.0,
"path": [[1056.0, 1678.0], [1296.0, 1678.0], [1296.0, 1535.0], [1200.0, 1415.0], [1056.0, 1326.0], [896.0, 1326.0]],
"point": [1296.0, 1678.0]
}, {
"action": "左下击A→下击B→右下击C→下射；前三次真实伤害各补回一发，同次腾空越过608高的大空域，落回下方宽岸可重新组织动作。",
"label": "高段综合：四枪左右换向",
"number": 3.0,
"path": [[896.0, 1326.0], [896.0, 1183.0], [992.0, 1064.0], [992.0, 910.0], [885.0, 800.0], [885.0, 718.0]],
"point": [896.0, 1326.0]
}, {
"action": "综合段之后只需普通跳跃加一次向下反冲，分两次短登岸到共用20币位置与既有出口门台，不再安排续枪资源题。",
"label": "短登岸收尾",
"number": 4.0,
"path": [[885.0, 718.0], [960.0, 718.0], [896.0, 430.0], [832.0, 430.0], [768.0, 142.0]],
"point": [960.0, 718.0]
}, {
"action": "右侧铜环保持单独易行线，跳起接环即可绕过两课和四枪精密连射，448宽顶岸接住最后一次脱钩小踢，终点与无H路线共用。",
"label": "H外侧易行路线",
"number": 5.0,
"path": [[1184.0, 2030.0], [1328.0, 1904.0], [1456.0, 1744.0], [1536.0, 1552.0], [1456.0, 1360.0], [1456.0, 1168.0], [1456.0, 976.0], [1376.0, 784.0], [1184.0, 592.0], [1184.0, 352.0], [1088.0, 430.0], [832.0, 430.0]],
"point": [1184.0, 2030.0]
}, {
"action": "下层宽岸连接入口、武器匠和上行挑战。",
"label": "下层原通路",
