"schema": 1.0,
"steps": [{
"action": "保留五向枢纽与交通笼，主岸轻战斗；平台2右侧局部刺约束下行选择，进入载台前仍有安静观察位。",
"label": "汇口辨路",
"number": 1.0,
"path": [[336.0, 1966.0], [448.0, 1806.0], [448.0, 1646.0], [1056.0, 1614.0], [1392.0, 1614.0], [1760.0, 1806.0], [1984.0, 2062.0], [2080.0, 2004.0], [2080.0, 1006.0], [2672.0, 1006.0]],
"point": [336.0, 1966.0]
}, {
"action": "长桥来向仍可沿左侧落入中层；新增16肩台也承担返回上口的抬升。",
"label": "长桥来向下降",
"number": 2.0,
"path": [[192.0, 398.0], [512.0, 558.0], [512.0, 750.0], [928.0, 1198.0], [1408.0, 1422.0], [1056.0, 1614.0]],
"point": [192.0, 398.0]
}, {
"action": "交通笼在上层岸12出笼后，经15、14、8、16、7返回长桥；补上原来缺失的西向接续，避免从同一路径硬顶448高差。根铃在实心宽岸14预警，右射打断同时反冲向左侧桥岸；可先清理再跳。",
"label": "从交通笼返回长桥",
"number": 3.0,
"path": [[1984.0, 558.0], [1568.0, 622.0], [1184.0, 750.0], [984.0, 750.0], [672.0, 750.0], [512.0, 558.0], [256.0, 398.0], [192.0, 398.0]],
"point": [1984.0, 558.0]
}]
