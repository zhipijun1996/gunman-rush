script = ExtResource("1_ey368")
room_id = "P-R15"
arrival_text = "风鸣钟台"
route_guide = {
"schema": 1.0,
"steps": [{
"action": "沿R6三处宽岸安全下降；钩点集中在井底横渡和失手恢复，不在整根长井散放。",
"label": "三处检修宽岸下降",
"number": 1.0,
"path": [[192.0, 142.0], [864.0, 366.0], [832.0, 910.0], [984.0, 2062.0], [800.0, 3214.0], [864.0, 3758.0]],
"point": [192.0, 142.0]
}, {
"action": "在准备岸看见第一停驻环；向右离岸下落越过井口实体转角，再逐环牵引，末环向左射击反冲到宽钟台，实际修钟与回桥捷径身份不变。",
"label": "H1—H3横渡至风鸣钟",
"number": 2.0,
"path": [[960.0, 3758.0], [1048.0, 3808.0], [1120.0, 3840.0], [1296.0, 3808.0], [1472.0, 3840.0], [1568.0, 3918.0], [1952.0, 3918.0], [2112.0, 3918.0]],
"point": [960.0, 3758.0]
}, {
"action": "横渡失手落到安全盆地；逐环跳离再钩上行，最上环位于钟台左侧外缘，可跳回钟台，不靠未实现的回弹。",
"label": "H4—H7底部恢复",
"number": 3.0,
"path": [[1152.0, 4686.0], [1152.0, 4528.0], [1280.0, 4320.0], [1408.0, 4112.0], [1488.0, 3896.0], [1632.0, 3918.0]],
"point": [1152.0, 4686.0]
}]
}
