"schema": 1.0,
"steps": [{
"action": "向留在右岸的守桥怪射击，反冲同次跨到左接收岸；接收岸加宽32提供余量，保留提前清怪后的空射通行。",
"label": "回身射击越断桥",
"number": 1.0,
"path": [[1776.0, 910.0], [1504.0, 910.0], [1469.0, 827.0], [1202.0, 910.0], [608.0, 910.0]],
"point": [1776.0, 910.0]
}, {
"action": "东桥下凹室由左侧进入，桥墩藏箱一次散落10金币。经检修台回桥，不沿台阶撒币。",
"label": "桥墩内探查",
"number": 2.0,
"path": [[1504.0, 910.0], [1480.0, 1198.0], [1776.0, 1198.0], [1480.0, 1198.0], [1432.0, 1070.0], [1536.0, 910.0]],
"point": [1480.0, 1198.0]
}, {
"action": "5加宽、6下移32并向左加宽；5→6高差128，7加宽至256且下移64，6→7高差192。5的刺移到左边短段、6的刺移到右端，给起跳与反冲落点留出空间。守台怪移至7右段，6完整承担起跳准备；7左侧保留落脚再判断的空间。",
"label": "宽石肩上果园",
"number": 3.0,
"path": [[608.0, 910.0], [640.0, 686.0], [720.0, 686.0], [864.0, 558.0], [1072.0, 558.0], [1168.0, 366.0], [1344.0, 142.0]],
"point": [608.0, 910.0]
}, {
"action": "西侧低地由俯冲怪守20金币藏箱；从平台左端下探，原路跳回石肩。",
"label": "西侧空角守藏",
"number": 4.0,
"path": [[256.0, 1070.0], [176.0, 1070.0], [80.0, 1198.0], [176.0, 1070.0], [256.0, 1070.0]],
