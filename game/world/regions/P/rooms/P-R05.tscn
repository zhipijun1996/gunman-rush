route_guide = {
"schema": 1.0,
"steps": [{
"action": "保留原射铃载台和同驱齿轮；观察齿轮相位后登台，不在这段精密移动里加追击怪。",
"label": "开传动并登慢台",
"number": 1.0,
"path": [[144.0, 366.0], [544.0, 324.0], [640.0, 292.0]],
"point": [144.0, 366.0]
}, {
"action": "在载台起跳后向左下的检修铃[448,336]开枪。真实命中停住同一传动的载台与齿轮；反冲同时把人送上检修岸。保留其他合法时机解法。",
"label": "回射停传动并离台",
"number": 2.0,
"path": [[612.0, 299.0], [649.0, 216.0], [876.0, 206.0], [928.0, 206.0]],
"point": [612.0, 299.0]
}, {
"action": "TG02保留唯一正式奖励；领取后开返程闸，下＋跳穿过领奖台，下落至回廊开口时向左射击，借反冲向右穿入通廊，开启回06吊桥。原底部0–1536整行地刺，失足按现行地形失败回准备岸；左侧2/3检修台保留可站恢复。",
"label": "取唯一铜齿并开原返程",
"number": 3.0,
"path": [[928.0, 206.0], [1360.0, 142.0], [1456.0, 142.0], [1488.0, 142.0], [1488.0, 534.0], [1664.0, 622.0], [1776.0, 622.0]],
