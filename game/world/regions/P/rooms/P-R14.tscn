route_guide = {
"schema": 1.0,
"steps": [{
"action": "入口台不动；加宽第一转身岸，向右收束上两级石肩，让反冲后的身体有承接面。Boss封门、战场盒与原三层战斗平台保持。",
"label": "错肩进入Boss庭地",
"number": 1.0,
"path": [[512.0, 1230.0], [384.0, 1102.0], [416.0, 942.0], [400.0, 742.0], [592.0, 742.0]],
"point": [512.0, 1230.0]
}, {
"action": "领取H后，上层石肩按上—下—上错落，宽落点承接钩索与反冲换向，不再整排同一水平线。",
"label": "战后铜环与起伏石肩",
"number": 2.0,
"path": [[1800.0, 742.0], [1984.0, 558.0], [2080.0, 366.0], [2592.0, 334.0], [3264.0, 430.0], [3504.0, 296.0], [3744.0, 232.0], [4064.0, 366.0], [4392.0, 288.0], [4608.0, 224.0], [4736.0, 398.0]],
"point": [1800.0, 742.0]
}, {
"action": "战后可从奖励岸下落，跨两处160宽断口沿中央高肩回到S3侧闸；回程低廊从一条超长薄板改成三段。",
"label": "下层可回走的三段廊",
