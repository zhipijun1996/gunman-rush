[node name="P-R09" type="Node2D" unique_id=1645072537]
script = ExtResource("1_4twoh")
room_id = "P-R09"
arrival_text = "矿口旧栈道"
route_guide = {
"schema": 1.0,
"steps": [{
"action": "上门落到安全实体岸；沿货井乘货梯到中央货台。向西可预览未施工矿口，向东到岸底开口观察铃与闸。",
"label": "由货井观察矿口",
"number": 1.0,
"path": [[1344.0, 142.0], [1440.0, 220.0], [1440.0, 1004.0], [1392.0, 1070.0], [1840.0, 942.0], [2048.0, 1006.0]],
"point": [1344.0, 142.0]
}, {
"action": "矿口接驳只保留连接所需长度。左下管口后的暗室向右敞开，净高128、门槛32；短跳进入领取10金币旧货箱，再由右沿跳回货台，无需破墙。",
"label": "缩短矿口接驳与左下暗室",
"number": 2.0,
"path": [[704.0, 942.0], [512.0, 1070.0], [304.0, 1198.0], [224.0, 1166.0], [128.0, 1166.0], [240.0, 1166.0], [352.0, 1070.0], [704.0, 942.0]],
"point": [304.0, 1198.0]
}, {
"action": "从准备岸踏入缺口，回身向左下射入80高的宽铃口。子弹打开闸，同枪反冲向右上跨过缺口并落到闸后宽岸。射偏落刺则回到准备岸；射口不靠针眼限制玩家。",
"label": "下落后回身射铃",
"number": 3.0,
"path": [[2048.0, 1006.0], [2191.0, 1093.0], [2343.0, 1066.0], [2388.0, 1086.0], [2420.0, 1134.0], [2480.0, 1134.0]],
"point": [2048.0, 1006.0]
}, {
"action": "东端上层由守卫争夺20金币检修藏箱。回程从东台左缘跳起向右下射击，反冲左上接检修台；射访问铃后短跳回主路，途中不另堆浮台。",
"label": "上层取财，换边回环",
"number": 4.0,
"path": [[2480.0, 1134.0], [2912.0, 1006.0], [2752.0, 878.0], [3008.0, 750.0], [2920.0, 750.0], [2885.0, 690.0], [2647.0, 702.0], [2528.0, 702.0], [2240.0, 702.0], [2048.0, 1006.0]],
"point": [2480.0, 1134.0]
}, {
"action": "沿中央货台到货梯；中间无横梁穿过轨道。乘至上端后向左跳回安全入口岸。",
"label": "返回货井",
"number": 5.0,
"path": [[2048.0, 1006.0], [1840.0, 942.0], [1392.0, 1070.0], [1440.0, 1032.0], [1440.0, 248.0], [1344.0, 142.0]],
"point": [2048.0, 1006.0]
}]
}
