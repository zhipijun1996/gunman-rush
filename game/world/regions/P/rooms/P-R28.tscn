"schema": 1.0,
"steps": [{
"action": "顶门实体台减薄。1右端、2左端、3右端局部刺；各阶肩有安全观察岸，可用已有下看确认下一侧，沿9接到谷仓宽岸。",
"label": "交错刺肩下降",
"number": 1.0,
"path": [[1664.0, 142.0], [1548.0, 142.0], [1552.0, 398.0], [1676.0, 260.0], [1776.0, 622.0], [1680.0, 480.0], [1568.0, 846.0], [1640.0, 846.0], [1760.0, 700.0], [1840.0, 1070.0], [1968.0, 1070.0], [2032.0, 1262.0]],
"point": [1664.0, 142.0]
}, {
"action": "保留朝右下守卫开枪、身体反冲左上的高效路线；西田上层仍可分步进入。",
"label": "上田攻击换层",
"number": 2.0,
"path": [[880.0, 1390.0], [819.0, 1261.0], [675.0, 1188.0], [584.0, 1262.0]],
"point": [880.0, 1390.0]
}, {
"action": "上檐凹室净高104、开口128，短跳配横向反冲进入10金币藏箱岸；由错开的上口分两次各落128到下袋。",
"label": "11内侧10金币",
"number": 3.0,
"path": [[656.0, 1390.0], [464.0, 1390.0], [424.0, 1332.0], [272.0, 1390.0], [160.0, 1390.0], [304.0, 1390.0], [336.0, 1440.0], [384.0, 1518.0]],
"point": [656.0, 1390.0]
}, {
"action": "在160宽中台下看确认凹袋底面，128宽口进入96净高凹袋领取10金币藏箱；两次普通跳回原肩，不依赖怪物存活。",
"label": "5内部10金币",
"number": 4.0,
"path": [[384.0, 1518.0], [304.0, 1518.0], [256.0, 1590.0], [224.0, 1646.0], [96.0, 1646.0], [224.0, 1646.0], [260.0, 1536.0], [304.0, 1498.0], [352.0, 1518.0], [384.0, 1518.0], [424.0, 1380.0], [464.0, 1368.0], [496.0, 1390.0], [656.0, 1390.0]],
"point": [384.0, 1518.0]
