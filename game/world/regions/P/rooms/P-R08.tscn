script = ExtResource("1_3a6jf")
room_id = "P-R08"
arrival_text = "封井回廊"
route_guide = {
"schema": 1.0,
"steps": [{
"action": "第一台启动后，跳起向右命中根铃，同枪向左反冲登台；清怪后仍可射铃往返。右角旧货箱一次散落20金币，不是开台条件。",
"label": "回身命中并登台",
"number": 0.0,
"path": [[944.0, 2926.0], [944.0, 2825.0], [816.0, 2868.0]],
"point": [944.0, 2926.0]
}, {
"action": "射铃启台，顶部向左上反冲换到第二台。",
"label": "提水吊台",
"number": 1.0,
"path": [[704.0, 2926.0], [864.0, 2868.0], [864.0, 2228.0], [576.0, 2020.0]],
"point": [704.0, 2926.0]
}, {
"action": "第二台顶部向右上反冲接第三台；登台后击铃启动。",
"label": "反冲换乘",
"number": 2.0,
"path": [[576.0, 2020.0], [576.0, 1380.0], [896.0, 1156.0]],
"point": [576.0, 2020.0]
}, {
"action": "从第三台最高点跳向左侧井口，轨道上方保持净空。",
"label": "井口落岸",
"number": 3.0,
"path": [[896.0, 1156.0], [896.0, 212.0], [704.0, 142.0]],
"point": [896.0, 1156.0]
}, {
"action": "第三台升至侧岸附近时，向右打访问铃停台，反冲落到左侧岸；由岸上向左打铃重启，同枪向右反冲重新登台。齿轮只争夺横跨路径。",
"label": "上井停台与返回",
"number": 4.0,
"path": [[896.0, 1026.0], [853.0, 922.0], [608.0, 974.0], [568.0, 974.0], [612.0, 873.0], [838.0, 876.0]],
"point": [896.0, 1026.0]
}]
}
