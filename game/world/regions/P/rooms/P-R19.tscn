route_guide = {
"schema": 1.0,
"steps": [{
"action": "从低路回望桥下藏室：巡逻与俯冲怪守20金币藏箱，底部右段刺床保留左侧宽战斗面；由两层宽台回原低路。",
"label": "低路与井底藏室",
"number": 1.0,
"path": [[144.0, 1902.0], [608.0, 1902.0], [704.0, 2286.0], [608.0, 2318.0], [560.0, 2478.0], [320.0, 2670.0], [128.0, 2670.0], [416.0, 2478.0], [560.0, 2318.0], [704.0, 2286.0]],
"point": [144.0, 1902.0]
}, {
"action": "第一笼只升到中层宽岸。根铃在实心平台9预警，玩家可跳离或射击打断；局部刺迫使换落点。清理后准备向右射铃，身体向左登第二笼。",
"label": "第一段起井，换岸交战",
"number": 2.0,
"path": [[896.0, 2126.0], [1088.0, 2084.0], [1088.0, 1524.0], [928.0, 1518.0], [880.0, 1518.0], [744.0, 1518.0]],
"point": [896.0, 2126.0]
}, {
"action": "右侧风铃启动第二笼；朝右射击同时把身体送向左侧载台。第二笼斜向右上收束到平台8，失败可回中层宽岸，顶端访问铃能召回或停台。允许先启动后登台。",
"label": "射铃启笼并反冲登台",
"number": 3.0,
"path": [[880.0, 1518.0], [824.0, 1416.0], [736.0, 1444.0], [928.0, 996.0], [1008.0, 942.0]],
"point": [880.0, 1518.0]
}, {
"action": "第三笼接上门，途中左侧哨兵守10金币检修箱；射右侧访问铃停笼并反冲上左岸，处理遭遇后射左铃再搭笼。上门保留安静落台。",
"label": "上井有侧岸可停战",
"number": 4.0,
"path": [[1008.0, 942.0], [1060.0, 852.0], [1120.0, 868.0], [1120.0, 656.0], [960.0, 622.0], [1120.0, 628.0], [1120.0, 180.0], [1024.0, 142.0]],
"point": [1008.0, 942.0]
}, {
"action": "原三个钩点、TG04高岸、奖励与返程机关保留。新上升岸均在井道西侧，未把台阶接入右侧奖励；新怪不放到TG04附近充当回枪台阶。",
"label": "TG04仍是H+D回访",
"number": 5.0,
