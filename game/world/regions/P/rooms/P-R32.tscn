room_id = "P-R32"
arrival_text = "悬铃长桥"
route_guide = {
"schema": 1.0,
"steps": [{
"action": "利用桥墩遮挡清理射线，反冲跨越两处断口。",
"label": "断桥推进",
"number": 1.0,
"path": [[208.0, 1006.0], [672.0, 1006.0], [1184.0, 942.0], [1952.0, 814.0]],
"point": [208.0, 1006.0]
}, {
"action": "从桥墩右侧跳起，朝左射身后的启动铃，同时向右反冲登检修台。也允许先启台再登台；上岸后是安全远眺段，保留钟心地标与东出口。",
"label": "回身启台并登台",
"number": 2.0,
"path": [[2096.0, 814.0], [2130.0, 714.0], [2224.0, 772.0], [2336.0, 612.0], [2496.0, 622.0], [2928.0, 622.0]],
"point": [2096.0, 814.0]
}, {
"action": "检修岸下方回环通旧集，保留可重搭的载台。",
"label": "下层出口",
"number": 3.0,
"path": [[2224.0, 1006.0], [2432.0, 1230.0], [2304.0, 1296.0]],
"point": [2224.0, 1006.0]
}, {
"action": "从桥墩跳起挂住中继环，再跳上宽检修岸；从岸边跳起连续挂环到上口。",
"label": "H 回访上桥",
"number": 4.0,
"path": [[1184.0, 942.0], [1200.0, 680.0], [1104.0, 622.0], [960.0, 416.0], [960.0, 224.0], [960.0, 142.0]],
"point": [1184.0, 942.0]
}, {
"action": "从下层检修台向左进入桥墩内，巡逻体守10金币检修箱。清理取奖后原路返回下层台，接下方汇口；洞顶隔开上层射线。",
"label": "桥墩内检修藏室",
"number": 5.0,
"path": [[2224.0, 1006.0], [2144.0, 1038.0], [1936.0, 1038.0], [1792.0, 1038.0], [2144.0, 1038.0], [2240.0, 1006.0]],
"point": [2224.0, 1006.0]
}]
}
