arrival_text = "退潮渠畔"
route_guide = {
"schema": 1.0,
"steps": [{
"action": "东堤外伸檐挡住地面射线；离岸略下落后向右下打檐下铃，同枪左上反冲穿1.5秒闸到一体接落岸，再回宽西堤。返向在西岸预开侧铃再起跳，失败落底刺按原地形恢复。",
"label": "离岸下坠回射开前闸",
"number": 1.0,
"path": [[2928.0, 942.0], [2352.0, 942.0], [2239.0, 998.0], [2144.0, 905.0], [2024.0, 1070.0], [2024.0, 944.0], [1944.0, 944.0], [1944.0, 1006.0]],
"point": [2928.0, 942.0]
}, {
"action": "借192高落地防波墩隔开冲锋线；回射右下地怪可同时上墩，随后射右上空哨并向左离墩跨96刺槽。左岸另有80短刺与跃击守转角。普通清怪后仍可走，怪物不是一次性必需踏脚。",
"label": "桥下防波墩回射换位",
"number": 2.0,
"path": [[1944.0, 1006.0], [1680.0, 1006.0], [1304.0, 1006.0], [1232.0, 862.0], [1120.0, 780.0], [992.0, 780.0], [960.0, 814.0], [896.0, 720.0], [736.0, 880.0], [720.0, 942.0], [672.0, 800.0], [512.0, 800.0], [512.0, 942.0], [432.0, 942.0]],
"point": [1944.0, 1006.0]
}, {
"action": "反冲上左宽肩后换边上桥；桥左段544与现行边界352之间留192净空，普通短跨过64地刺，经64抬阶和巡逻守卫进入原高井。上口高肩和从门台右侧接入的位置保留。",
"label": "宽肩上低桥，再入原高井",
"number": 3.0,
"path": [[432.0, 942.0], [432.0, 650.0], [336.0, 650.0], [336.0, 718.0], [432.0, 560.0], [512.0, 472.0], [576.0, 526.0], [704.0, 526.0], [736.0, 416.0], [864.0, 416.0], [864.0, 526.0], [976.0, 526.0], [1024.0, 400.0], [1136.0, 400.0], [1216.0, 462.0], [1216.0, 304.0], [1344.0, 304.0], [1344.0, 334.0], [1408.0, 334.0], [1408.0, 100.0], [1280.0, 100.0], [1280.0, 142.0]],
"point": [432.0, 942.0]
}, {
"action": "左墙连体侧台集中15金币箱。取后可从右侧安全回落宽肩，也可用近水平反冲跨256缺口上桥；这条回桥捷径为可选，不取代安全返回。箱内15金币沿一次性收据散落。",
"label": "左壁集中收集与横向捷径",
"number": 4.0,
"path": [[288.0, 718.0], [240.0, 520.0], [128.0, 472.0], [80.0, 526.0], [176.0, 526.0], [240.0, 416.0], [448.0, 416.0], [560.0, 526.0]],
"point": [288.0, 718.0]
}, {
"action": "干岸同时承担战斗换位和H起点。铜环沿墙侧空隙上行，原行装和折梯身份保持；新稿不另铺金币。",
"label": "独立H行装支路",
"number": 5.0,
"path": [[1856.0, 750.0], [1824.0, 592.0], [1712.0, 448.0], [1600.0, 304.0], [1600.0, 112.0], [1712.0, 142.0], [1888.0, 142.0]],
"point": [1856.0, 750.0]
}]
