script = ExtResource("1_0paer")
room_id = "P-R12"
arrival_text = "春水地窖"
route_guide = {
"schema": 1.0,
"steps": [{
"action": "下层入口乘短停井笼直达宽穿透接收岸。这里先观察西侧宝箱和右上层路线；失败可从宽岸重新组织。",
"label": "井笼进地窖",
"number": 1.0,
"path": [[272.0, 3310.0], [544.0, 3280.0], [544.0, 1454.0]],
"point": [272.0, 3310.0]
}, {
"action": "向左跳入储物拱室，击退守箱怪取20币，再回接收岸。",
"label": "西侧藏金",
"number": 2.0,
"path": [[544.0, 1454.0], [320.0, 1326.0], [160.0, 1326.0], [544.0, 1454.0]],
"point": [544.0, 1454.0]
}, {
"action": "起跳后向左下射击登右岸，清除平台守卫；避开右侧短刺，回身向右下射击登左岸。转角齿轮扫过换岸通道，观察后出发。",
"label": "错层反冲",
"number": 3.0,
"path": [[544.0, 1454.0], [704.0, 1300.0], [992.0, 1198.0], [832.0, 1040.0], [672.0, 942.0]],
"point": [544.0, 1454.0]
}, {
"action": "由左岸反冲到右上准备岸，向左下射铃，身体右上穿过临时侧闸，落到行装岸。",
"label": "上层开闸",
"number": 4.0,
"path": [[672.0, 942.0], [816.0, 790.0], [1008.0, 686.0], [944.0, 550.0], [1104.0, 462.0]],
"point": [672.0, 942.0]
}, {
"action": "收取原行装，放折梯。沿领奖岸右侧折梯下降回准备岸；若回上口，从左侧高肩上行；下行可沿宽台回井笼，不重新做上升挑战。",
"label": "领取与回环",
"number": 5.0,
"path": [[1104.0, 462.0], [1152.0, 462.0], [816.0, 302.0], [768.0, 142.0]],
"point": [1104.0, 462.0]
}]
}
