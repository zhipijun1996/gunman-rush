arrival_text = "田下回水洞"
route_guide = {
"schema": 1.0,
"steps": [{
"action": "左入口的实心安全岸缩为320宽；下到中层泵台后向左折返，进入宽阔操作岸。中层泵台同时承担当期返左入口的落脚和巡逻遭遇。",
"label": "进入左下泵房",
"number": 1.0,
"path": [[144.0, 238.0], [320.0, 238.0], [439.0, 430.0], [416.0, 430.0], [303.0, 622.0]],
"point": [144.0, 238.0]
}, {
"action": "短跳时向身后开枪：子弹命中风铃，启动吊斗；同一枪反冲把玩家送上已在移动的吊斗。沿横轨转入中井上升，从上端向右走下东岸。允许先开铃再登台。",
"label": "射铃同时登台",
"number": 2.0,
"path": [[368.0, 622.0], [411.0, 567.0], [565.0, 559.0], [669.0, 644.0], [800.0, 644.0], [800.0, 197.0], [943.0, 302.0]],
"point": [368.0, 622.0]
}, {
"action": "下层东侧保留原来的H绕墙、三个钩点、TG03和返程折梯。只保留这一个真实收集目标，不新增散落金币或虚构奖励。",
"label": "原铜齿探索",
"number": 3.0,
"path": [[768.0, 878.0], [800.0, 736.0], [1008.0, 736.0], [1008.0, 576.0], [1040.0, 526.0]],
"point": [768.0, 878.0]
}, {
"action": "底层越过短刺沟，登实体恢复台，再跳回操作岸；短跳漏枪则直接落在恢复台。下层和东岸的同组铃可以远程起停载台，错过班次可等其8秒周期回程。",
"label": "失误回岸",
"number": 4.0,
"path": [[744.0, 878.0], [675.0, 739.0], [499.0, 750.0], [369.0, 622.0], [304.0, 622.0]],
"point": [768.0, 878.0]
}, {
"action": "从吊斗上端回落中层泵台，再从台的左端跳起，射向右下、反冲左上回到西侧入口。不是从井顶直接横跨到西门。",
"label": "返回西门",
"number": 5.0,
"path": [[800.0, 197.0], [700.0, 240.0], [560.0, 430.0], [432.0, 430.0], [389.0, 328.0], [300.0, 200.0], [250.0, 238.0], [144.0, 238.0]],
"point": [800.0, 197.0]
}]
}
