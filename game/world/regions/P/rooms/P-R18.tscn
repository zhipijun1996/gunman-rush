route_guide = {
"schema": 1.0,
"steps": [{
"action": "西入口降到低田应对冲锋，再反冲上高田；第二沟下方通地窖和灌溉路，可经穿透平台返回当前田畦。",
"label": "错层田畦与下方灌溉路",
"number": 1.0,
"path": [[144.0, 1134.0], [352.0, 1134.0], [640.0, 1230.0], [992.0, 1230.0], [1216.0, 1070.0], [1408.0, 1070.0], [1760.0, 1134.0], [2048.0, 1134.0]],
"point": [144.0, 1134.0]
}, {
"action": "下层或中层射铃召回第一台，抵达中段后跳上准备岸，再向右换到自动斜行的崖台；东崖上岸后通P07。两条轨道与乘员头顶保持独立净空。",
"label": "两段错位换乘登东崖",
"number": 2.0,
"path": [[2080.0, 1422.0], [2240.0, 1348.0], [2240.0, 836.0], [2240.0, 686.0], [2464.0, 804.0], [2256.0, 260.0], [2480.0, 238.0]],
"point": [2080.0, 1422.0]
}, {
"action": "高田向下射击守卫可借反冲上观望层；C05保持未施工封闭边界。下井通P30，清怪后仍可经井中接收台与东岸台返回。",
"label": "上层观望与窄井回环",
"number": 3.0,
"path": [[1280.0, 1070.0], [1280.0, 814.0], [1440.0, 590.0], [1760.0, 654.0], [1984.0, 814.0], [2304.0, 1774.0], [2272.0, 1566.0], [2400.0, 1390.0], [2672.0, 1262.0], [2800.0, 1134.0]],
"point": [1280.0, 1070.0]
}, {
"action": "从田畦右缘下探原地窖，到左下集中金币位置；取后走到原岸右缘，向左下射击反冲跨过渠底短刺，接回原回升路。箱内20金币沿一次性收据散落。",
"label": "左下地窖集中20金币",
"number": 4.0,
"path": [[992.0, 1230.0], [1040.0, 1336.0], [992.0, 1454.0], [672.0, 1454.0], [1032.0, 1454.0], [1376.0, 1422.0]],
"point": [992.0, 1230.0]
}]
}
