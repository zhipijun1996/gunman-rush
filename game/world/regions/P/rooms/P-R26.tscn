route_guide = {
"schema": 1.0,
"steps": [{
"action": "西台前侧留出准备；起跳后回身射左侧访问铃，同枪向右反冲登上启动的吊台，再在上端换岸。原移动台上巡逻怪移到入口后的宽地。",
"label": "西吊台换岸",
"number": 1.0,
"path": [[736.0, 1390.0], [960.0, 1332.0], [960.0, 836.0], [1376.0, 654.0]],
"point": [736.0, 1390.0]
}, {
"action": "从检修岸登东台，升高后向左上反冲接棚口；落下可召回重试。",
"label": "东吊台折返",
"number": 2.0,
"path": [[1712.0, 654.0], [1936.0, 596.0], [2192.0, 356.0], [2112.0, 142.0]],
"point": [1712.0, 654.0]
}, {
"action": "底路跳起反冲跨过一段160宽短刺，进入右侧檐下处理巡逻守卫后开启原有宝箱；原路回到西吊台准备岸，宝箱身份和内容不变。",
"label": "检修底路与原暗室宝箱",
"number": 3.0,
"path": [[1120.0, 1518.0], [1440.0, 1518.0], [1664.0, 1518.0], [1984.0, 1518.0], [2240.0, 1518.0], [1664.0, 1518.0], [1440.0, 1518.0], [912.0, 1518.0], [736.0, 1390.0]],
