signs = Array[Dictionary]([{"point":[192,2576],"text":"左侧是田垄；右下旧路回初行草坡。"},{"point":[6784,368],"text":"荆棘上廊：高压挑战。普通下路：平台与守路怪。两条路都向西通田垄。","route_guide":{"schema":1,"steps":[{"number":1,"point":[6800,368],"label":"荆棘上路 / 普通下路","action":"左侧荆棘标出高压路线；普通平台向右下接地面便道。上廊在入口一侧进入，奖励在西端。","path":[[6976,238],[6752,398],[6624,686],[6624,1230],[5680,1582]]},{"number":2,"point":[5712,1904],"label":"上廊挑战","action":"沿密刺上廊控制落点，用水平反冲跨短台；末段在空中向身后射铃并反冲穿闸。","path":[[5712,1966],[5312,1966],[5008,1966],[4736,1966],[4480,1966],[4192,1966],[3872,1966],[3680,1966],[3392,1966],[3104,1966],[2944,1966],[2544,1966],[2160,1966],[2200,2222],[704,2222],[384,2222]]},{"number":3,"point":[4576,2432],"label":"下层普通路","action":"普通跨步、柱后冲锋与上梁绕敌。低路不要求硬过刺坑；接近04时能看见上层奖励，想挑战就沿下路回入口。","path":[[5952,2222],[5776,2478],[5088,2478],[4416,2382],[4128,2286],[3296,2478],[2032,2478],[1392,2478],[416,2478],[144,2606]]},{"number":4,"point":[448,2222],"label":"生命碎片与单向返回","action":"奖励侧打开返程折板，下落到熟悉的主路；领取前不能从下路直接登上这一段。","path":[[384,2222],[576,2222],[576,2478],[144,2606]]}]}},{"point":[5712,1776],"text":"左上荆棘廊通向西端生命碎片；下方是普通便道。"},{"point":[416,2432],"text":"上面是生命碎片。入口一侧的荆棘上廊通到这里；领奖侧才能打开返程板。"},{"point":[624,2784],"text":"旧路肩下通初行草坡。击铃召回吊台。"}])

