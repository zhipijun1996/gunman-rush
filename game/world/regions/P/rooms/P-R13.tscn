script = ExtResource("1_5vxom")
room_id = "P-R13"
arrival_text = "旧路肩高台"
route_guide = {
"schema": 1.0,
"steps": [{
"action": "上路是自愿反冲荆棘挑战；下路是普通平台战斗，靠近04时再看见奖励。",
"label": "上下分路",
"number": 1.0,
"path": [[5680.0, 1582.0], [5808.0, 1838.0], [5200.0, 2062.0]],
"point": [5680.0, 1582.0]
}, {
"action": "东、中、西三段吊顶与顶刺改变净空；在高腔调整射向，高台边短跳后向右上射击压低轨迹，向左落入低腔，离开低顶后再抬升。",
"label": "高低顶刺下换向穿行",
"number": 2.0,
"path": [[5200.0, 2062.0], [4720.0, 1902.0], [4576.0, 1902.0], [4368.0, 1902.0], [4080.0, 2062.0], [3744.0, 2062.0], [3440.0, 2030.0], [3056.0, 2030.0]],
"point": [5200.0, 2062.0]
}, {
"action": "最后一处夹刺观察后反冲；取得碎片再开返程折板落回主路。",
"label": "最后收窄",
"number": 3.0,
"path": [[3056.0, 2030.0], [2832.0, 2176.0], [2400.0, 2222.0], [384.0, 2222.0], [448.0, 2478.0]],
"point": [3056.0, 2030.0]
}, {
"action": "低廊掩体提供观察与换边；跃起后朝右击中身后根铃，同枪向左反冲跨越短刺口。清怪后也可普通跳跃跨过，西侧局部刺继续限制落脚；上层HP01保持独立挑战与单向返程。",
"label": "下路回身退击跨口",
"number": 4.0,
"path": [[5888.0, 2478.0], [5488.0, 2446.0], [5184.0, 2478.0], [5024.0, 2478.0], [4954.0, 2339.0], [4800.0, 2478.0], [4128.0, 2350.0], [2800.0, 2478.0], [1104.0, 2478.0], [144.0, 2606.0]],
"point": [5888.0, 2478.0]
}]
}
