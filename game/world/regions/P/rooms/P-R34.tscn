"schema": 1.0,
"steps": [{
"action": "入口由门台右侧下落，越过左檐短刺后进入广场；冲锋线与低纪念台提供越敌换边，空中俯冲怪争夺高点。从上层落入宽岸交战，失手在低层重新组织路线。",
"label": "从檐口进入冲锋广场",
"number": 1.0,
"path": [[192.0, 142.0], [336.0, 142.0], [336.0, 302.0], [144.0, 302.0], [144.0, 430.0], [224.0, 430.0], [288.0, 280.0], [400.0, 350.0], [432.0, 430.0], [432.0, 590.0], [512.0, 590.0], [688.0, 590.0], [736.0, 814.0], [880.0, 814.0], [960.0, 1038.0], [1136.0, 1038.0], [1200.0, 840.0], [1344.0, 800.0], [1344.0, 910.0], [1504.0, 910.0], [1600.0, 1038.0]],
"point": [192.0, 142.0]
}, {
"action": "井口与宽阶地接第二组局部遭遇。跃击怪争夺底岸，空哨在上层转角封线；沿一体建筑的三层高差反冲登高。",
"label": "明井与东侧交战岸",
"number": 2.0,
