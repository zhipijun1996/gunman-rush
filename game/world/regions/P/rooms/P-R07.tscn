route_guide = {
"schema": 1.0,
"steps": [{
"action": "6右段加64宽刺，左侧保留96宽起跳/落脚面；越刺跳向上路。原掩体跳射与反冲回避保留。",
"label": "上路借掩体还击",
"number": 1.0,
"path": [[144.0, 1070.0], [640.0, 942.0], [1088.0, 1006.0], [1152.0, 888.0], [1008.0, 1006.0], [1280.0, 846.0]],
"point": [144.0, 1070.0]
}, {
"action": "原主台1厚256削为64，下方得到连续低拱通路；局部64宽刺留起跳和接收地，巡逻守东段宽地。低路接东岸，不封井口。",
"label": "桥下低拱换位",
"number": 2.0,
"path": [[784.0, 1198.0], [1056.0, 1198.0], [1091.0, 1138.0], [1248.0, 1198.0], [1536.0, 1198.0], [1744.0, 1198.0]],
"point": [784.0, 1198.0]
}, {
"action": "原平台2缩成128宽左接驳岸，真正开放1792–2048落槽。保留井内交错单向台和底部门；原448宽实体曾横封整个井口。",
"label": "打开的东井接驳",
"number": 3.0,
"path": [[1744.0, 1198.0], [1888.0, 1358.0], [1744.0, 1518.0], [1984.0, 1678.0]],
"point": [1744.0, 1198.0]
}, {
"action": "从原井内两级岸回东接驳岸，再上主路或走桥下返回；原门和入口落脚不变。",
"label": "向西返回",
"number": 4.0,
"path": [[1984.0, 1678.0], [1744.0, 1518.0], [1952.0, 1358.0], [1744.0, 1198.0], [1600.0, 1006.0], [1088.0, 1006.0], [640.0, 942.0], [144.0, 1070.0]],
"point": [1984.0, 1678.0]
}, {
"action": "沿右肩上升、越过局部刺台，再借左上钩点进入40金币藏箱岸。回访支路不堵初访主路；取得后折返下到原上路。",
"label": "上空折返与钩索藏金",
"number": 5.0,
"path": [[1456.0, 846.0], [1707.0, 622.0], [1808.0, 622.0], [1902.0, 398.0], [1648.0, 302.0], [1454.0, 162.0], [1344.0, 96.0], [1256.0, 142.0], [1120.0, 142.0], [1360.0, 142.0], [1360.0, 846.0]],
