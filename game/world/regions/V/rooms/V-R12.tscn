signs = Array[Dictionary]([{"point":[192,1814],"text":"所有实体墙面均可攀附，墙刺危险。攀墙或钩头命中恢复空弹、D/H和Q资格，冷却保留。按编号向前；1接墙，2绕墙脚抓环，3向上反冲穿金色光幕。","route_guide":{"schema":1,"steps":[{"number":1,"point":[240,1760],"label":"起步接墙","action":"向右上反冲，二段跳接第一面墙；向墙移动即可攀附并恢复次数。","path":[[144,1838],[260,1740],[338,1680]]},{"number":2,"point":[428,1788],"label":"绕墙脚抓环","action":"沿第一面墙下滑，到墙脚下方横向反冲，二段跳抬起后向上抓低位钩点。别落入粉红刺床。左上墙是可选练习支路。","path":[[338,1700],[338,1800],[424,1800],[528,1660]]},{"number":3,"point":[552,1600],"label":"反冲穿光幕","action":"挂环等Q冷却结束，向下射击，反冲向上一次穿出金色光幕；二段跳向右接内墙。","path":[[544,1648],[544,1488],[594,1412]]},{"number":4,"point":[702,1174],"label":"中继落地","action":"贴墙恢复后，用墙跳、向上反冲和二段跳越过墙顶，落到中继台。失误从这里重试。","path":[[594,1412],[568,1190],[720,1198]]},{"number":5,"point":[856,1100],"label":"斜跨外墙","action":"从中继台向右上反冲，二段跳接右侧外墙，再次恢复次数。","path":[[740,1198],[868,1080],[898,1000]]},{"number":6,"point":[660,850],"label":"绕隔墙抓高环","action":"从外墙向左上推进，先绕开隔墙下缘，再向上抓高位钩点。","path":[[898,1000],[828,866],[664,866],[624,720]]},{"number":7,"point":[560,742],"label":"向左下穿幕","action":"挂环等Q就绪，向右上射击使反冲朝左下；穿过金幕后接内侧墙。普通下落不受保护。","path":[[624,704],[560,742],[480,782],[414,836]]},{"number":8,"point":[572,632],"label":"接高墙","action":"从内侧墙向右上反冲，二段跳接高墙左面；绕开上方齿轮和墙顶刺。","path":[[414,836],[560,690],[658,576]]},{"number":9,"point":[850,260],"label":"终台与返程","action":"墙跳、反冲和二段跳越过高墙，落到终台；拉手柄放桥，沿左侧落井回入口。","path":[[658,576],[612,364],[744,284],[880,302]]}],"legend":[{"mode":"phase_light","label":"金色：反冲保护光幕","instruction":"Q可用时用反冲穿越，结束反冲前必须离开光幕；普通跳跃、钩索不提供穿幕保护。"},{"mode":"thorns","label":"粉红：实体尖刺","instruction":"接触危险，Q也无法抵挡；绕行，失误返回最近恢复点。"}]}},{"point":[672,1174],"text":"中继台记录重试点。继续按5—9前进，绕隔墙抓高环，再向左下反冲穿幕。金色光幕需Q就绪并靠反冲一次穿出，单纯跳跃/钩索无保护；粉红刺和齿轮始终危险。"},{"point":[960,278],"text":"折星回路终台。拉下手柄放出返程桥，向左走到安全落井，下落回入口。右侧 V-R13 是未施工接口。本轮为快速灰盒，完整节奏和容错等你试玩反馈。"}])
