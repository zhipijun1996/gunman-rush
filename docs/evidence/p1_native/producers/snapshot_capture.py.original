import json,hashlib,subprocess,sys
from pathlib import Path
sys.path.insert(0,'tools');import visual_director as vd
folder=Path(sys.argv[1]);r,d=vd.load_capture(folder/'visual_capture.json');names=set(subprocess.check_output(['git','diff','--name-only','HEAD'],text=True).splitlines())|set(subprocess.check_output(['git','ls-files','--others','--exclude-standard'],text=True).splitlines());names.update(r['capture_extension']['sources']);index={}
for name in sorted(names):
 if name not in r['source_before']:continue
 data=Path(name).read_bytes();h=hashlib.sha256(data).hexdigest()
 if h!=r['source_before'][name]:raise RuntimeError('snapshot bytes drift '+name)
 target=folder/'source_snapshot'/name;target.parent.mkdir(parents=True,exist_ok=True);target.write_bytes(data);index[name]=h
vd.write(folder/'source_snapshot/index.json',index);vd.write(folder/'inspection.json',vd.inspect_capture(folder/'visual_capture.json'))
summary={'status':'captured_prototype_complete_same_first_space_pending_art_admission','git_parent_commit':r['request']['source_commit'],'git_parent_is_not_complete_dirty_source':True,'source_identification':'captured source_before/source_after inventory and matched actual dirty/capture-closure source bytes; not an invented new Git commit','actual_source_inventory_sha256':hashlib.sha256(json.dumps(r['source_before'],sort_keys=True,separators=(',',':')).encode()).hexdigest(),'source_unchanged':r['source_before']==r['source_after'],'source_snapshot':'source_snapshot/index.json','snapshot_file_count':len(index),'catalog':d['visual_sample_treatment'],'manifest_hash':d['manifest_hash'],'actual_polygon_count':len(d['spatial_golden_initial_physics']['solid_polygons']),'tick_count':len(d['frames']),'outcome':d['outcome'],'route_reached':d['route_reached'],'cases':d['spatial_golden_cases'],'health_values':sorted({x['health'] for x in d['frames']}),'final_recovery_count':d['frames'][-1]['recovery_count'],'accepted_shots':sum(x['kind']=='shot_accepted' for x in d['events']),'root_pulses':sum(x['kind']=='root_pulse' for x in d['events']),'movie':'gameplay.mp4','movie_seconds':r['media']['format']['duration'],'video_frames':len(r['video_frames']),'wall_seconds':r['wall_seconds'],'consumer_inventory':d['finite_asset_library_inventory'],'scope':'Prototype feedback of the SAME FIRST SPACE, identified by its directory and captured source inventory; not second space, final committed A/E, user/device/commercial approval or fullCI. Prior feedback660 stays FAILED budget-limited.','audio':'encoded 48k stereo; not personally listened to'};vd.write(folder/'summary.json',summary);print(json.dumps({k:summary[k] for k in ['git_parent_commit','source_unchanged','snapshot_file_count','tick_count','outcome','health_values','final_recovery_count','movie_seconds','wall_seconds']},ensure_ascii=False))
