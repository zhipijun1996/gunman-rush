from pathlib import Path
import sys,os,subprocess,time,json,ctypes,selectors,shutil,hashlib
ROOT=Path(__file__).resolve().parents[2];sys.path.insert(0,str(ROOT/'tools'));import visual_director as vd
out=ROOT/'build/p1_random/gui_04';out.mkdir(exist_ok=False);before=vd.sources('tools/p1_random_capture.gd');receipt={'source_before':before,'producer_sha256':hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),'probe_sha256':hashlib.sha256((ROOT/'build/p1_random/avatar_gui_probe_04.gd').read_bytes()).hexdigest(),'status':'failed','started_unix':time.time()};env=os.environ.copy();env.update(LIBGL_ALWAYS_SOFTWARE='1',LP_NUM_THREADS='1',ALSA_CONFIG_PATH=str(ROOT/'build/p1_native/alsa-null.conf'));display=process=None;log=(out/'native.log').open('wb');dl=(out/'display.log').open('wb')
try:
 display=subprocess.Popen([shutil.which('Xvfb') or str(ROOT.parent/'toolchains/xvfb/usr/bin/Xvfb'),'-displayfd','1','-screen','0','1280x720x24','-nolisten','tcp','-ac'],stdout=subprocess.PIPE,stderr=dl)
 with selectors.DefaultSelector() as s:
