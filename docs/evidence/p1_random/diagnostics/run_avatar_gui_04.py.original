 if process and process.poll() is None:process.terminate();process.wait(timeout=10)
 if display:display.terminate();display.wait(timeout=10)
 log.close();dl.close();receipt['finished_unix']=time.time();receipt['source_after']=vd.sources('tools/p1_random_capture.gd');(out/'receipt.json').write_text(json.dumps(receipt,indent=2)+'\n');print(json.dumps({'status':receipt['status'],'error':receipt.get('error')}))
raise SystemExit(0 if receipt['status']=='passed' else 1)
