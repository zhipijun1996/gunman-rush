   except json.JSONDecodeError:time.sleep(.03);continue
   if step['sequence'] not in seen:
    step['focus_audit']=focus_audit()
    if '_item' in step['label'] or step['label']=='pause_MENU':
     subprocess.run(['ffmpeg','-hide_banner','-loglevel','error','-threads','1','-f','x11grab','-video_size','1280x720','-i',env['DISPLAY'],'-frames:v','1','-threads','1',str(out/(step['label']+'_native_popup.png'))],env=env,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=10)
    a,b=map(round,step['screen_position']);xt.XTestFakeMotionEvent(pointer,-1,a,b,0);x.XFlush(pointer);time.sleep(.08);xt.XTestFakeButtonEvent(pointer,1,1,0);x.XFlush(pointer);time.sleep(.08);xt.XTestFakeButtonEvent(pointer,1,0,0);x.XFlush(pointer);events.append(step);seen.add(step['sequence'])
  time.sleep(.04)
 receipt['exit_code']=process.returncode;receipt['actual_pointer_events']=events
 text=(out/'native.log').read_text(errors='replace');result=json.loads((out/'result.json').read_text()) if (out/'result.json').is_file() else {}
 if process.returncode!=0 or result.get('status')!='passed' or any(s in text for s in ('SCRIPT ERROR:','ERROR:','ObjectDB instances leaked','resources still in use')):raise RuntimeError('Native GUI/API assertions or strict cleanup failed')
 receipt['source_after']=vd.sources('tools/p1_random_capture.gd');assert before==receipt['source_after'];receipt['status']='passed'
except BaseException as e:receipt['error']=type(e).__name__+': '+str(e)
