 x.XFetchName.argtypes=[ctypes.c_void_p,ctypes.c_ulong,ctypes.POINTER(ctypes.c_char_p)];x.XFree.argtypes=[ctypes.c_void_p]
 x.XSetInputFocus.argtypes=[ctypes.c_void_p,ctypes.c_ulong,ctypes.c_int,ctypes.c_ulong];x.XGetInputFocus.argtypes=[ctypes.c_void_p,ctypes.POINTER(ctypes.c_ulong),ctypes.POINTER(ctypes.c_int)]
 x.XSync.argtypes=[ctypes.c_void_p,ctypes.c_int]
 def focus_audit():
  desktop=x.XDefaultRootWindow(pointer);r=ctypes.c_ulong();parent=ctypes.c_ulong();children=ctypes.POINTER(ctypes.c_ulong)();count=ctypes.c_uint();rows=[];target=0
  x.XQueryTree(pointer,desktop,ctypes.byref(r),ctypes.byref(parent),ctypes.byref(children),ctypes.byref(count))
  for i in range(count.value):
   name=ctypes.c_char_p();w=children[i];x.XFetchName(pointer,w,ctypes.byref(name));title=name.value.decode(errors='replace') if name.value else '';rows.append({'window':w,'title':title})
   if 'P1' in title or 'Godot' in title:target=w
   if name:x.XFree(name)
  if children:x.XFree(children)
  beforefocus=ctypes.c_ulong();revert=ctypes.c_int();x.XGetInputFocus(pointer,ctypes.byref(beforefocus),ctypes.byref(revert))
  if target and beforefocus.value in (0,1):x.XSetInputFocus(pointer,target,2,0);x.XSync(pointer,0)
  afterfocus=ctypes.c_ulong();x.XGetInputFocus(pointer,ctypes.byref(afterfocus),ctypes.byref(revert));return {'windows':rows,'before_focus':beforefocus.value,'selected_focus':target,'after_focus':afterfocus.value}
 command=['bash','tools/godot.sh','--verbose','--rendering-method','gl_compatibility','--path','.','--script','build/p1_random/avatar_gui_probe_04.gd'];receipt['command']=command;process=subprocess.Popen(command,cwd=ROOT,env=env,stdout=log,stderr=subprocess.STDOUT);seen=set();events=[];deadline=time.monotonic()+100
 while process.poll() is None:
  if time.monotonic()>deadline:raise TimeoutError('Actual pointer GUI deadline')
