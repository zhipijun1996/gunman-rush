+func _observe_platform_actual_shot(shot_id: int, encounter: BellstriderEncounter) -> void:
+	# Actual ShootAbility signal, not a request ordinal or impact-time label.
+	platform_fired_shots.append({"tick": Engine.get_physics_frames(), "shot_id": shot_id, "fire_group": int(encounter.combat_metrics().get("groups_started", -1)), "owner_id": app.controller.motor.get_instance_id(), "session_id": app.controller.session_id})
+
