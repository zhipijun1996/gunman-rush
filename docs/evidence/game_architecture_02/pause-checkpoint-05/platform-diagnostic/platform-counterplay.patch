+func _platform_counterplay_input(app: Node, encounter: Node, metrics: Dictionary) -> Dictionary:
+	# Only decisions and receipt state live here. Collision, jump replenishment,
+	# contact damage, frozen attack selection and recovery shots remain original.
+	var player: PlayerMotor = app.player
+	var state := str(encounter.mode)
+	var current_group := int(metrics.get("groups_started", 0))
+	var hp: float = app.controller.actor_resources.health.current
+	var grounded := player.is_on_floor()
+	var phase := str(platform_trial.phase)
+	if phase == "waiting":
+		if current_group == 0:
+			return {}
+		var plan: Dictionary = metrics.get("group_plan", {})
+		if current_group != 1 or state != "roll_warning" or str(plan.get("kind", "")) != "roll" or int(plan.get("phase", -1)) != 1:
+			return _platform_trial_failed("first autonomous group was not the specified phase1 roll warning")
+		if not bool(platform_observation.get("valid", false)) or not grounded:
+			return _platform_trial_failed("first warning lacks installed support data or actual starting ground")
+		var selected: Dictionary = {}
+		# Lowest existing authored one-way tier, then nearest center. No world
+		# coordinates, predicted jump trajectory, frame search or synthetic floor.
+		for candidate: Dictionary in platform_observation.platforms:
+			var rect: Rect2 = candidate.rect
+			if selected.is_empty() or rect.position.y > (selected.rect as Rect2).position.y or (is_equal_approx(rect.position.y, (selected.rect as Rect2).position.y) and absf(rect.get_center().x - player.global_position.x) < absf((selected.rect as Rect2).get_center().x - player.global_position.x)):
+				selected = candidate.duplicate(true)
+		if selected.is_empty():
+			return _platform_trial_failed("no installed one-way support in the existing Bell arena")
+		platform_trial.merge({"phase": "boarding", "group": current_group, "plan": plan.duplicate(true), "target": selected, "HP_start": hp, "HP_min": hp, "first_tick": Engine.get_physics_frames(), "initial_side": signf(app.stage.boss.global_position.x - player.global_position.x)}, true)
+		phase = "boarding"
+		_platform_trial_event("boarding_requested", platform_observation)
+	if phase == "failed" or phase == "complete":
+		return {}
+	platform_trial.HP_min = minf(float(platform_trial.HP_min), hp)
+	if hp < float(platform_trial.HP_start):
+		return _platform_trial_failed("actual HP decreased during the first committed group")
+	if not bool(platform_observation.get("valid", false)) or int(platform_observation.max_jumps) != 1 or int(platform_observation.effective_max_jumps) != 1 or bool(platform_observation.hook_enabled):
+		return _platform_trial_failed("actual support or base-only ability contract unavailable")
+	var target: Dictionary = platform_trial.target
+	var same_target := false
+	for candidate: Dictionary in platform_observation.platforms:
+		if candidate.body_id == target.body_id and candidate.path == target.path and candidate.rect == target.rect:
+			same_target = true
+	if not same_target:
+		return _platform_trial_failed("selected installed support changed or disappeared")
+	var supported := false
+	for support: Dictionary in platform_observation.floor_contacts:
+		if support.body_id == target.body_id and support.path == target.path:
+			supported = grounded
+	var rect: Rect2 = target.rect
+	var axis := _toward(player.global_position.x, rect.get_center().x, 7.0)
+	var jump := false
+	if phase == "boarding":
+		if not grounded:
+			if not bool(platform_trial.board_airborne):
+				_platform_trial_event("actual_boarding_takeoff", platform_observation)
+			platform_trial.board_airborne = true
+		if supported and bool(platform_trial.board_airborne):
+			if state != "roll_warning":
+				return _platform_trial_failed("did not actually land on the platform inside first warning")
+			platform_trial.phase = "supported"
+			axis = 0.0
+			platform_trial.support_tick = Engine.get_physics_frames()
+			jump_until = frame # Release original held input after actual first landing.
+			_platform_trial_event("actual_platform_landing", platform_observation)
+		elif state != "roll_warning":
+			return _platform_trial_failed("warning ended before actual platform landing")
+		elif grounded and not bool(platform_trial.board_airborne):
+			jump = true
+	elif phase == "supported":
+		axis = 0.0
+		if not supported:
+			return _platform_trial_failed("lost actual platform support before evade jump")
+		var bounds: Rect2 = platform_observation.rig_bounds
+		var direction: float = encounter.direction
+		var incoming: bool = (app.stage.boss.global_position.x - player.global_position.x) * direction < 0.0
+		var front := bounds.position.x if direction < 0 else bounds.end.x
+		if state == "roll" and incoming and front >= rect.position.x and front <= rect.end.x:
+			if not is_zero_approx(player.normal_velocity.x):
+				return _platform_trial_failed("incoming front arrived before actual horizontal motion stopped")
+			axis = 0.0
+			jump = true
+			platform_trial.phase = "evading"
+			platform_trial.trigger_tick = Engine.get_physics_frames()
+			platform_trial.trigger_front = front
+			_platform_trial_event("incoming_front_jump_requested", platform_observation)
+		elif state not in ["roll_warning", "roll"]:
+			return _platform_trial_failed("first incoming rig event was not observed while supported")
+	elif phase == "evading":
+		axis = 0.0 # Vertical ordinary jump, not a chase or position correction.
+		if not grounded:
+			if not bool(platform_trial.evade_airborne):
+				_platform_trial_event("actual_evade_takeoff", platform_observation)
+			platform_trial.evade_airborne = true
+			var side := signf(app.stage.boss.global_position.x - player.global_position.x)
+			if side != 0 and side != float(platform_trial.initial_side) and state == "roll" and not bool(platform_trial.crossed_airborne):
+				platform_trial.crossed_airborne = true
+				_platform_trial_event("actual_airborne_side_crossing", platform_observation)
+		elif bool(platform_trial.evade_airborne):
+			platform_trial.landed = true
+			platform_trial.phase = "landed"
+			_platform_trial_event("actual_evade_landing", platform_observation)
+	if int(metrics.get("groups_completed", 0)) >= int(platform_trial.group):
+		if not bool(platform_trial.landed) or not bool(platform_trial.crossed_airborne):
+			return _platform_trial_failed("first group completed without actual airborne crossing and landing")
+		platform_trial.phase = "complete"
+		platform_trial.complete_tick = Engine.get_physics_frames()
+		_platform_trial_event("first_group_motion_complete_NOT_full_fight_acceptance", platform_observation)
+		return {}
+	if str(platform_trial.phase) == "landed":
+		return {} # Original two-shot recovery consumer remains authoritative.
+	return {"override": true, "axis": axis, "jump": jump}
+
+
+func _platform_trial_failed(reason: String) -> Dictionary:
+	platform_trial.phase = "failed"
+	platform_trial.failure = reason
+	_platform_trial_event("platform_hypothesis_failed_NO_retry", platform_observation)
+	return {} # Preserve all later original fight failures; no alternate strategy.
+
+
+func _platform_trial_event(action: String, observation: Dictionary) -> void:
+	input_rows.append({"frame": frame, "physics_tick": Engine.get_physics_frames(), "action": action, "group": group, "trial": platform_trial.duplicate(true), "actual_support_observation": observation.duplicate(true)})
