+func _bell_platform_observation(stage: PlainsRegionStage, player: PlayerMotor, encounter: BellstriderEncounter) -> Dictionary:
+	# Observe the already installed Module shapes and native Motor collisions.
+	# This never creates shapes, raycasts a replacement floor or predicts physics.
+	var result: Dictionary = {"valid": false, "platforms": [], "floor_contacts": [], "max_jumps": player.tuning.max_jumps, "effective_max_jumps": app.controller.jump_ability.maximum_jumps(), "hook_enabled": app.controller.traversal.hook_enabled, "rig_bounds": encounter.body_contact_rect()}
+	var selected: PlatformingModule = null
+	for module: PlatformingModule in stage.assembler.modules:
+		if module.definition.module_id == &"plains_bellstrider_arena":
+			if selected != null:
+				return result
+			selected = module
+	if selected == null:
+		return result
+	for index: int in selected.definition.one_way_platform_indices:
+		var body := selected.get_node_or_null("Platform%d" % index) as StaticBody2D
+		var shape: CollisionShape2D = body.get_node_or_null("CollisionShape2D") as CollisionShape2D if body != null else null
+		if shape == null or not shape.shape is RectangleShape2D or not shape.one_way_collision or shape.disabled or not body.is_in_group("one_way_platform"):
+			return result
+		var authored: Rect2 = selected.global_transform * selected.definition.platforms[index]
+		var installed: Rect2 = shape.global_transform * shape.shape.get_rect()
+		if not authored.is_equal_approx(installed):
+			return result
+		result.platforms.append({"path": str(body.get_path()), "body_id": body.get_instance_id(), "rect_xywh": [installed.position.x,installed.position.y,installed.size.x,installed.size.y], "module": str(selected.definition.module_id), "platform_index": index, "rect": installed})
+	for index: int in player.get_slide_collision_count():
+		var collision := player.get_slide_collision(index)
+		var body := collision.get_collider() as PhysicsBody2D
+		if body != null and collision.get_normal().dot(player.up_direction) > .7:
+			result.floor_contacts.append({"path": str(body.get_path()), "body_id": body.get_instance_id(), "normal": [collision.get_normal().x,collision.get_normal().y], "point": [collision.get_position().x,collision.get_position().y]})
+	var rig: Rect2 = result.rig_bounds
+	result["rig_xywh"] = [rig.position.x,rig.position.y,rig.size.x,rig.size.y]
+	result.valid = not result.platforms.is_empty()
+	return result
+
+
+func _record_platform_trial_verdict() -> void:
+	# Evaluated at receipt time, after the last observed physics tick resolved.
+	# These extra opt-in checks do not replace any original full-fight predicate.
+	if not platform_counterplay:
+		return
+	var trial: Dictionary = bell_pilot.platform_trial if bell_pilot != null else {}
+	var checks: Dictionary = {"first_group_completed": str(trial.get("phase", "")) == "complete" and int(trial.get("group", -1)) == 1, "actual_board_airborne": bool(trial.get("board_airborne", false)), "actual_evade_airborne": bool(trial.get("evade_airborne", false)), "actual_airborne_crossing": bool(trial.get("crossed_airborne", false)), "actual_landing": bool(trial.get("landed", false)), "HP_unchanged": trial.has("HP_start") and is_equal_approx(float(trial.get("HP_start", -1)), float(trial.get("HP_min", -2)))}
+	var first_tick := int(trial.get("first_tick", -1))
+	var complete_tick := int(trial.get("complete_tick", -1))
+	var player_hits := 0
+	for event: Dictionary in damage_events:
+		if event.target == "player" and int(event.tick) >= first_tick and int(event.tick) <= complete_tick:
+			player_hits += 1
+	checks["whole_group_no_committed_player_damage_inclusive"] = first_tick >= 0 and complete_tick >= first_tick and player_hits == 0
+	var group_shots := 0
+	if bell_pilot != null:
+		for row: Dictionary in bell_pilot.input_rows:
+			if row.get("action", "") == "shoot_release" and int(row.get("group", -1)) == 1 and bool(row.get("submitted", false)):
+				group_shots += 1
+	var bell_hits := 0
+	for event: Dictionary in final_bell_metrics.get("events", []):
+		if event.get("event", "") == "bellstrider_bell_hit" and int(event.get("group", -1)) == 1 and is_equal_approx(float(event.get("amount", 0)), 1.0):
+			bell_hits += 1
+	checks["original_two_requested_shots_and_two_actual_base_one_hits"] = group_shots == 2 and bell_hits == 2
+	for key: String in checks:
+		if not bool(checks[key]):
+			failure.append("platform diagnostic failed: " + key)
+	if bell_pilot != null:
+		bell_pilot.input_rows.append({"action": "platform_trial_receipt_verdict", "checks": checks, "trial": trial.duplicate(true), "committed_player_damage_count": player_hits, "group_submitted_shots": group_shots, "actual_base_one_bell_hits": bell_hits, "scope": "first autonomous phase1 group only; original full-fight checks still required"})
