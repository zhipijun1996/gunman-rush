ns%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":13,"digest":"sha256:38885c88f75abbc797a1db7559719800279a00cfb9fa8b2e2868a7f6f84bad2e","download_count":0,"created_at":"2026-10-31T09:23:51Z","updated_at":"2026-10-31T09:23:52Z","browser_download_url":"https://github.com/zhipijun1996/gunman-rush/releases/download/toolchain-godot-4.7.2-gunman-sd1/version.txt"}],"tarball_url":"https://api.github.com/repos/zhipijun1996/gunman-rush/tarball/toolchain-godot-4.7.2-gunman-sd1","zipball_url":"https://api.github.com/repos/zhipijun1996/gunman-rush/zipball/toolchain-godot-4.7.2-gunman-sd1","body":"Fixed Godot 4.7.2 Standard custom distribution (`gunman_sd1`) for gunman-rush. Built from official source `ed1daf0bf001b61586d9930840f2f1394092c079` with exactly upstream PR117991 and PR120976, using the pinned source, patches, SDKs, containers and production build recipe in commit `184970c7fff5baa6842efb8f34339ce87fff5bfd`.\n\nIncludes the Linux x86_64 editor and templates, Windows x86_64 debug/release templates, threaded and single-threaded Web debug/release templates, and Android ARM64 debug/release/source templates. This is a custom Standard distribution, not an official Godot release.\n\nAll ten build lanes and packaging completed in [run 41180438395](https://github.com/zhipijun1996/gunman-rush/actions/runs/41180438395). All outputs and provenance were independently checked; the eight distribution files were reproduced byte for byte by the checked-in packager. `SHA256SUMS.json` covers the other seven files; the lock candidate pins editor, binary, template archive, every template member and provenance hashes.\n\nThis release publishes toolchain artifacts. Full game regression, exported application and device acceptance are tracked separately.\n"}