+	_data = {}
+	_textures.clear()
+	_icons.clear()
+	_frames.clear()
+	_last_error = ""
+	_texture_rgba_bytes = 0
+	var value: Variant = JSON.parse_string(FileAccess.get_file_as_string(CONFIG_PATH))
