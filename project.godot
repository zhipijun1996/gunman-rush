; Godot Standard project. Physics values live in config/player_tuning.json.
config_version=5

[application]
config/name="Gunman Rush"
run/main_scene="res://scenes/demo/demo.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
GameTypography="*res://scripts/ui/demo_ui_01/game_typography.gd"

[gui]
theme/custom_font="res://assets/ui/demo_ui_01/r2/fonts/fusion-pixel-12px-proportional-zh_hans.otf"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[physics]
common/physics_ticks_per_second=60

[editor_plugins]
enabled=PackedStringArray("res://addons/runtime_raw_export/plugin.cfg")

[input_devices]
pointing/emulate_mouse_from_touch=false
pointing/emulate_touch_from_mouse=false

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.075, 0.105, 1)
